<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WT.Maui.Views.Auth.LoginPage"
             Title="Sign in">
  <ScrollView>
    <VerticalStackLayout Padding="18" Spacing="12">

      <Label Text="Sign in to WheelyTrails" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

      <Label Text="Email" />
      <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" />

      <Label Text="Password" />
      <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password" />

      <Label TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" 
             Text="{Binding ErrorMessage}" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToSubmittingTextConverter}}"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                HeightRequest="44" />

        <ActivityIndicator Grid.Column="1" IsVisible="{Binding IsSubmitting}" IsRunning="{Binding IsSubmitting}" 
                           VerticalOptions="Center" HorizontalOptions="End" WidthRequest="44" />
      </Grid>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>