<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WT.Maui.Views.Auth.LoginPage"
             Title="Sign in">

  <ScrollView>
    <VerticalStackLayout Padding="18" Spacing="12">

      <Label Text="Sign in to WheelyTrails" Style="{StaticResource HeadlineMedium}" HorizontalOptions="Center" />

      <Label Text="Email" Style="{StaticResource FormLabel}" />
      <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email" Style="{StaticResource FormEntry}" />

      <Label Text="Password" Style="{StaticResource FormLabel}" />
      <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password" Style="{StaticResource FormEntry}" />

      <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}"
              Style="{StaticResource ErrorBanner}">
        <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource OnErrorContainer}" />
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Button Text="{Binding IsSubmitting, Converter={StaticResource BoolToSubmittingTextConverter}}"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsSubmitting, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource PrimaryButton}" />

        <ActivityIndicator Grid.Column="1" 
                           IsVisible="{Binding IsSubmitting}" 
                           IsRunning="{Binding IsSubmitting}" 
                           VerticalOptions="Center" 
                           HorizontalOptions="End" 
                           WidthRequest="44" />
      </Grid>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>