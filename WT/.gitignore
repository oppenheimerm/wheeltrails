# Visual Studio / .NET Core / Node.js standard gitignore

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
## Get latest from `dotnet new gitignore`

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop/Xamarin Studio
*.userprefs

# Build results
[Dd]ebug*/
[Rr]elease*/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]in/
[Oo]bj/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio cache/options directory
.vs/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# npm / node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Rider
.idea/
*.sln.iml

# DotCover, NCrunch and other tooling
*.dotCover
_NCrunch_*

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# IIS
IISExpress/*

# EF Core Migrations (if you accidentally generate locally)
**/Migrations/

# Rider
.idea/

# Local history
.localhistory/

# Coverage
coverage*/
*.coverage
*.coveragexml

# Terraform
.terraform/

# macOS
.DS_Store

# Windows
Thumbs.db

# Secrets and service account keys (do not commit)
*.pfx
*.publishsettings
firebase-keys/
*firebase-adminsdk*.json
wheelytrails-firebase*.json

# Blazor WASM specifics
# Keep appsettings in wwwroot but never commit secrets to it
!**/wwwroot/appsettings.json

# Ignore generated client index.html (contains injected API keys)
WT.Client/wwwroot/index.html

# Optional: ignore build artifacts and static web assets if built into repo
WT.Client/wwwroot/css/app.css
WT.Client/wwwroot/js/*.map

# End of standard gitignore

.env