@{
    var title = ViewData["Title"] ?? "WT Admin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>

    <base href="/" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <!-- Material Design3 - Roboto Font Family -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- Material Design3 - FFigtree Font Family -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <!-- Material Symbols (Rounded style for Material3) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Material Design3 Theme CSS -->
    <link href="css/material-theme/theme.css" rel="stylesheet" />

    <!-- Tailwind CSS (compiled with Material3 tokens) -->
    <link rel="stylesheet" href="css/app.css??vs=17012026-0" />

    <!-- Tailwind CSS (compiled with Material3 tokens) -->
    <link rel="stylesheet" href="css/app.css??vs=17012026-0" />

    @RenderSection("HeadContent", required: false)
</head>
<body class="min-h-screen bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="app-root">
        @RenderBody()
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>