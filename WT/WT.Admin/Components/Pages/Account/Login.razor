@layout WT.Admin.Components.Layout.AuthLayout
@page "/account/login"
@using System.Linq.Expressions
@using WT.Application.DTO.Request.Account
@inject HttpClient Http
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

@implements IDisposable

@code {
    private WT.Application.DTO.Request.Account.LoginDTO ModelDTO { get; set; } = new();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private bool isSubmitting = false;
    private string? errorMessage;
    private bool rememberMe = false;
    private bool isPasswordVisible = false;

    protected override void OnInitialized()
    {
        editContext = new EditContext(ModelDTO);
        messageStore = new ValidationMessageStore(editContext);
    }

    private void TogglePassword()
    {
        isPasswordVisible = !isPasswordVisible;
        // For simplicity this toggles the icon only. If needed, bind input type to isPasswordVisible.
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            StateHasChanged();

            // Post to local admin controller which will call the API and issue cookie
            var resp = await Http.PostAsJsonAsync("/account/login", ModelDTO);
            if (resp.IsSuccessStatusCode)
            {
                // Navigate and force reload so cookie is used for subsequent requests
                Nav.NavigateTo("/", true);
            }
            else
            {
                try
                {
                    var apiErr = await resp.Content.ReadFromJsonAsync<Dictionary<string, object?>>();
                    if (apiErr != null && apiErr.TryGetValue("message", out var msg))
                        errorMessage = msg?.ToString() ?? "Login failed";
                    else
                    {
                        var authErr = await resp.Content.ReadFromJsonAsync<WT.Application.DTO.Response.APIResponseAuthentication>();
                        errorMessage = authErr?.Message ?? "Login failed";
                    }
                }
                catch
                {
                    errorMessage = "Login failed";
                }
            }
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        // leave for debugging or analytics
    }

    private bool HasValidationErrors(Expression<Func<string?>> accessor)
    {
        if (editContext == null) return false;
        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private string GetInputClass(Expression<Func<string?>> accessor)
    {
        return HasValidationErrors(accessor) ? "wt-form-input-error" : "wt-form-input";
    }

    public void Dispose()
    {
        messageStore?.Clear();
    }
}


@* Simplified admin login layout: removed decorative illustration (lhs-image) to keep admin UI focused and compact *@
<div class="min-h-screen pt-0 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="max-w-2xl mx-auto px-4 py-16">
        <div class="w-full mx-auto">
            <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)] rounded-xl shadow-elevation-2 p-8">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-error-container)] text-[var(--md-sys-color-on-error-container)]">
                        @errorMessage
                    </div>
                }

                <div class="mb-6">
                    <h1 class="text-2xl md:text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Admin sign in</h1>
                    <p class="mt-2 text-sm text-[var(--md-sys-color-on-surface-variant)]">
                        Sign in with your admin credentials.
                    </p>
                </div>

                <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />

                    <div class="space-y-6">
                        <div>
                            <label class="wt-form-lbl" for="email">Email</label>
                            <div class="relative">
                                <InputText id="email"
                                           class="@GetInputClass(() => ModelDTO.Email)"
                                           placeholder="Email address"
                                           @bind-Value="ModelDTO.Email" />
                                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                    <span class="material-symbols-rounded text-[18px] text-[var(--md-sys-color-on-surface-variant)]">mail</span>
                                </div>
                            </div>
                            <ValidationMessage For="@(() => ModelDTO.Email)" class="wt-form-error-msg" />
                        </div>

                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <label class="wt-form-lbl" for="password">Password</label>
                                <a href="/account/forgot" class="text-sm font-medium text-[var(--md-sys-color-primary)] hover:underline">
                                    Forgot Password?
                                </a>
                            </div>

                            <div class="relative">
                                <InputText id="password"
                                           type="@(isPasswordVisible ? "text" : "password")"
                                           class="@($"{GetInputClass(() => ModelDTO.Password)} pr-10")"
                                           placeholder="Enter password"
                                           @bind-Value="ModelDTO.Password" />

                                <button type="button"
                                        @onclick="TogglePassword"
                                        class="absolute inset-y-0 right-0 pr-2 flex items-center text-[var(--md-sys-color-on-surface-variant)]
                                               bg-transparent rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                        aria-label="Toggle password visibility">
                                    <span class="material-symbols-rounded text-[18px]">@((isPasswordVisible) ? "visibility_off" : "visibility")</span>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => ModelDTO.Password)" class="wt-form-error-msg" />
                        </div>
                    </div>

                    <div class="mt-6 flex items-center justify-between text-sm text-[var(--md-sys-color-on-surface-variant)]">
                        <label class="inline-flex items-center gap-2">
                            <InputCheckbox @bind-Value="rememberMe" class="w-4 h-4" />
                            <span>Remember me</span>
                        </label>
                    </div>

                    <div class="mt-8">
                        <button type="submit"
                                class="w-full py-3 px-4 rounded-full text-[var(--md-sys-color-on-primary)] bg-[var(--md-sys-color-primary)]
                                       shadow-elevation-2 hover:shadow-elevation-3 transition transform active:scale-[.995]
                                       focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                disabled="@isSubmitting">
                            @(isSubmitting ? "Signing in..." : "Sign in")
                        </button>
                    </div>

                    <div class="my-6 flex items-center gap-4">
                        <hr class="flex-1 border-[var(--md-sys-color-outline)]" />
                        <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">or</p>
                        <hr class="flex-1 border-[var(--md-sys-color-outline)]" />
                    </div>

                    <div class="grid gap-3">
                        <button type="button" class="wt-btn-outline-social">Continue with Google</button>
                        <button type="button" class="wt-btn-outline-social">Continue with Apple</button>
                        <button type="button" class="wt-btn-outline-social">Continue with Facebook</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

