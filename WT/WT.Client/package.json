{
  "name": "wt.client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.css --watch",
    "inject-key": "node ../scripts/inject-google-key.js",
    "build:with-key": "npm run inject-key && npm run build",
    "build:workbox": "workbox injectManifest --swSrc workbox/service-worker.src.js --swDest wwwroot/service-worker.published.js --globDirectory wwwroot --globPatterns \"**/*.{html,js,css,png,svg,wasm,woff2,woff,eot,ttf,dll}\"",
    "bump": "node scripts/bump-version.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "workbox-build": "^6.5.4",
    "workbox-cli": "^7.4.0"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.8.29",
    "browserslist": "^4.28.0",
    "caniuse-lite": "^1.0.30001756",
    "electron-to-chromium": "^1.5.256",
    "escalade": "^3.2.0",
    "fraction.js": "^5.3.4",
    "nanoid": "^3.3.11",
    "node-releases": "^2.0.27",
    "normalize-range": "^0.1.2",
    "picocolors": "^1.1.1",
    "postcss-value-parser": "^4.2.0",
    "source-map-js": "^1.2.1",
    "tailwindcss": "^3.4.18",
    "update-browserslist-db": "^1.1.4"
  }
}
