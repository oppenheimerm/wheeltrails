 <!-- Register service worker. Prefer published Workbox file when present, fallback to dev service-worker.js -->
 <script>
 if ('serviceWorker' in navigator) {
	 window.addEventListener('load', async () => {
		 try {
			 // Prefer the Workbox-generated published service worker in production
			 let swUrl = '/service-worker.published.js';
			 try {
				 const res = await fetch(swUrl, { method: 'HEAD' });
				 if (!res.ok) {
					 swUrl = '/service-worker.js';
				 }
			 } catch (e) {
				 // If HEAD check fails, fallback to default dev SW
				 swUrl = '/service-worker.js';
			 }
 
			 navigator.serviceWorker.register(swUrl)
			 .then(reg => console.log('Service worker registered', reg))
			 .catch(err => console.warn('Service worker registration failed', err));
		 } catch (ex) {
			 console.warn('Service worker registration error', ex);
		 }
	 });
 }
 </script>

 <!-- Google Maps JS: replace __GOOGLE_MAPS_API_KEY__ at build/deploy time with your environment key. -->
