    {
        if (NewTrail == null) return;

        bool isChecked;
        try
        {
            isChecked = Convert.ToBoolean(value);
        }
        catch
        {
            isChecked = false;
        }

        if (isChecked)
            NewTrail.SurfaceTypes |= surface;
        else
            NewTrail.SurfaceTypes &= ~surface;

        // Notify EditContext of the change
        editContext?.NotifyFieldChanged(new FieldIdentifier(NewTrail, nameof(NewTrail.SurfaceTypes)));
    }*/

    public class Geoposition 
    { 
        public double lat { get; set; } 
        public double lng { get; set; }
        public double? altitude { get; set; }
        public DateTime? timestamp { get; set; }
    }

    private async Task SendDevSubmission()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            // Ensure we have data to send
            CreateTrailDTO payload = NewTrail;
            if (payload == null)
            {
                if (Waypoints.Count < 2)
                {
                    errorMessage = "No trail data to send. Record at least two waypoints first.";
                    return;
                }

                payload = new CreateTrailDTO
                {
                    Start = Waypoints.First(),
                    End = Waypoints.Last(),
                    Waypoints = Waypoints.ToList(),
                    PointsOfInterest = PointsOfInterest.ToList(),
                    Title = "Dev Recorded Trail",
                    Description = "Dev submission of recorded trail",
                    /*Difficulty = TrailDifficulty.Easy,*/
                    /*SurfaceTypes = SurfaceType.Paved*/
                };
            }

            // compute length if missing
            if (payload.LengthMeters <= 0)
            {
                double lengthMeters = 0;
                for (int i = 0; i < payload.Waypoints.Count - 1; i++)
                {
                    lengthMeters += CalculateDistance(payload.Waypoints[i], payload.Waypoints[i + 1]);
                }
                payload.LengthMeters = lengthMeters;
            }
            
            // Build elevation profile from waypoint altitudes if not already set
            if (payload.ElevationProfile == null || payload.ElevationProfile.Count == 0)
            {
                payload.ElevationProfile = payload.Waypoints
                    .Where(w => w.Altitude.HasValue)
                    .Select(w => w.Altitude!.Value)
                    .ToList();
            }

            var resp = await Http.PostAsJsonAsync("api/dev/log-trail", payload);
            if (resp.IsSuccessStatusCode)
            {
                try
                {
                    var body = await resp.Content.ReadFromJsonAsync<JsonElement?>();
                    if (body.HasValue && body.Value.ValueKind == JsonValueKind.Object && body.Value.TryGetProperty("file", out var f))
                    {
                        successMessage = $"Dev submission saved: {f.GetString()}";
                    }
                    else
                    {
                        successMessage = "Dev submission saved.";
                    }
                }
                catch
                {
                    successMessage = "Dev submission saved.";
                }
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                errorMessage = $"Dev submission failed: {txt}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error sending dev submission: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }
}

<!-- Layout -->
<div class="min-h-screen pt-16 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]" id="trail-stage">
    <div class="max-w-6xl mx-auto px-4 py-12" id="trail-stage-inner">
        <div class="grid md:grid-cols-2 gap-8 items-start">

            <!-- Map column -->
            <div class="rounded-xl overflow-hidden shadow-elevation-2 bg-[var(--md-sys-color-surface-container-lowest)]">
                <div id="map" style="width:100%; height:560px;"></div>
            </div>

            <!-- Controls column -->
            <div class="w-full max-w-xl mx-auto">
                <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)] rounded-xl shadow-elevation-2 p-6">

                    <h2 class="text-xl font-semibold mb-2">Record a New Trail</h2>
                    <p class="text-sm text-[var(--md-sys-color-on-surface-variant)] mb-4">Use the recorder to capture waypoints and points of interest. Add POIs while recording.</p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-error-container)] text-[var(--md-sys-color-on-error-container]">@errorMessage</div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-primary-container)] text-[var(--md-sys-color-on-primary-container)]">@successMessage</div>
                    }

                    <!-- Stats -->
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <p class="text-xs text-[var(--md-sys-color-on-surface-variant)]">Points recorded</p>
                            <p class="text-lg font-medium">@Waypoints.Count</p>
                        </div>
                        <div>
                            <p class="text-xs text-[var(--md-sys-color-on-surface-variant)]">Points of Interest</p>
                            <p class="text-lg font-medium">@PointsOfInterest.Count</p>
                        </div>
                        <div>
                            <p class="text-xs text-[var(--md-sys-color-on-surface-variant)]">Last Position</p>
                            <p class="text-lg font-medium">@LastPositionDisplay</p>
                        </div>

                        <div>
                            <p class="text-xs text-[var(--md-sys-color-on-surface-variant)]">Time</p>
                            <p class="text-lg font-medium">@ElapsedTimeDisplay</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button class="wt-btn-outline" @onclick="ToggleRecording">@(isRecording ? "Stop recording" : "Start recording")</button>
                        <button class="wt-btn-outline" @onclick="AddPoi" disabled="@(lastKnownPosition is null || !isRecording)">Add POI</button>

                        <button class="wt-btn" @onclick="SubmitTrail" disabled="@(isSubmitting)">@(isSubmitting ? "Submitting..." : "Submit")</button>

                        @if (isSubmitting)
                        {
                            <button class="wt-btn-outline" @onclick="CancelSubmit">Cancel</button>
                        }
                    </div>

                    @* TODO: Remove this dev-only button before shipping/deploying (temporary for local testing) *@
                    <!-- Dev submission button (temporary for developer testing) -->
                    @* Visible to any authenticated user while testing. Remove this block before shipping. *@
                    <div class="mt-4">
                        <button class="wt-btn wt-btn-danger" @onclick="SendDevSubmission">Send to Dev API</button>
                    </div>

                    <hr class="my-4" />

                    <div id="addi-medata-wrap">
                        <button class="wt-btn md:hidden mb-3" @onclick="() => metadataCollapsed = !metadataCollapsed">@(metadataCollapsed ? "Show details" : "Hide details")</button>

                        <div class="@(metadataCollapsed ? "hidden md:block" : "block")">
                            @if (NewTrail != null && editContext != null)
                            {
                                <EditForm EditContext="editContext">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />

                                    <div class="grid gap-4">
                                        <div>
                                            <label class="wt-form-lbl">Title</label>
                                            <InputText @bind-Value="NewTrail.Title" class="wt-form-input" maxlength="150" />
                                            <ValidationMessage For="() => NewTrail.Title" />
                                        </div>

                                        <div>
                                            <label class="wt-form-lbl">Description</label>
                                            <InputTextArea @bind-Value="NewTrail.Description" class="wt-form-input" maxlength="600" rows="2" />
                                            <ValidationMessage For="() => NewTrail.Description" />
                                        </div>




                                        <div>
                                            <label class="wt-form-lbl">Difficulty</label>
                                            <InputSelect @bind-Value="NewTrail.Difficulty" class="wt-form-input-dd">
                                                @foreach (var d in StringHelpers.GetTrailDifficulties())
                                                {
                                                    <option value="@d.Code">@d.Title</option>
                                                }
                                            </InputSelect>
                                            <ValidationMessage For="() => NewTrail.Difficulty" />
                                        </div>
                                    </div>

                                    <div class="flex justify-end gap-3 mt-4">
                                        <button type="button" class="wt-btn" @onclick="() => metadataCollapsed = true">Done</button>
                                    </div>
                                </EditForm>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@* Confirmation Modal *@
@if (showRecordingConfirm)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-40">
        <div class="bg-white dark:bg-harp-900 rounded-xl shadow-elevation-4 max-w-md w-full p-6">
            <h3 class="text-lg font-semibold text-wt-black-900 dark:text-white">Recording uses GPS</h3>
            <p class="text-sm text-[var(--md-sys-color-on-surface-variant)] mt-3">Recording uses your device GPS and may reduce battery life. High accuracy mode provides better tracks but uses more power. Continue?</p>

            <div class="mt-6 flex justify-end gap-3">
                <button class="wt-btn-outline" @onclick="() => { showRecordingConfirm = false; StateHasChanged(); }">Cancel</button>
                <button class="wt-btn-outline" @onclick="GoToSettingsFromModal">Change defaults in Settings</button>
                <button class="wt-btn" @onclick="StartRecordingAsync">Continue</button>
            </div>
        </div>
    </div>
}

@* Persistent recording banner/chip *@
@if (showRecordingBanner)
{
    <div class="fixed left-1/2 transform -translate-x-1/2 bottom-[calc(var(--tabbar-height,4rem)+3.25rem)] z-40">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-[var(--md-sys-color-primary-container)] text-[var(--md-sys-color-on-primary-container)] shadow-elevation-3">
            <span class="material-symbols-rounded">my_location</span>
            <div class="flex flex-col">
                <span class="text-sm font-medium">Recording — GPS in use. Tap to stop.</span>
                @if (isWakeLockActive)
                {
                    <span class="text-xs opacity-80">Screen wake lock active</span>
                }
                else if (isWakeLockSupported)
                {
                    <span class="text-xs opacity-80">Screen may sleep (wake lock unavailable)</span>
                }
                else
                {
                    <span class="text-xs opacity-80">May affect battery</span>
                }
            </div>
            <button class="ml-4 wt-btn-outline text-sm" @onclick="StopRecordingAsync">Stop</button>
        </div>
    </div>
}

@* POI Editor bottom sheet (if present) *@
<PoiEditor Poi="@editingPoi" IsOpen="@poiEditorOpen" OnSave="@OnPoiSave" OnCancel="@OnPoiCancel" />

<!-- POI list -->
<div class="max-w-6xl mx-auto px-4 py-4">
    <div id="poi-detail-wrap" class="bg-[var(--md-sys-color-surface)] dark:bg-[var(--md-sys-color-surface-container)] rounded-xl shadow-elevation-3 p-6 max-w-xl mx-auto min-h-[120px] border border-[var(--md-sys-color-outline-variant]" role="region" aria-label="Points of Interest">
        <h4 class="font-semibold mb-2">Points of Interest</h4>
        @if (PointsOfInterest.Count == 0)
        {
            <div class="text-sm text-[var(--md-sys-color-on-surface-variant)]">No POIs yet. Add one while recording.</div>
        }
        else
        {
            <ul class="space-y-3">
                @foreach (var poi in PointsOfInterest)
                {
                    <li class="flex items-center justify-between p-3 bg-white dark:bg-[var(--md-sys-color-surface)] rounded-md">
                        <div class="flex-1">
                            <div class="font-medium">@poi.Type</div>
                            <div class="text-xs text-[var(--md-sys-color-on-surface-variant)]">@poi.Notes</div>
                            <div class="text-xs text-[var(--md-sys-color-on-surface-variant)] mt-1">@string.Format("{0:F5}, {1:F5}", poi.Location.Lat, poi.Location.Lng)</div>
                        </div>
                        <div class="flex items-center gap-2 ml-4">
                            <button class="wt-btn-outline text-sm" @onclick="() => EditPoi(poi)">Edit</button>
                            <button class="wt-btn-outline text-sm" @onclick="() => DeletePoi(poi)">Delete</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

