@page "/trails/new"

@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using WT.Application.DTO.Request.Trail
@using WT.Domain.Geo
@using WT.Application.Extensions
@using WT.Client.Services

@inject IJSRuntime JS
@inject IFabService FabService
@inject NavigationManager NavigationManager
@inject IAccountService AccountService
@inject HttpClient Http

@implements IDisposable
@attribute [Authorize(Roles = Constants.Role.USER)]
<PageTitle>WheelyTrails - Add a new trail</PageTitle>

@code {
    private bool isRecording = false;
    private bool showRecordingConfirm = false;
    private bool showRecordingBanner = false;
    private List<WTLatLng> Waypoints { get; set; } = new();
    private List<WTPointOfInterest> PointsOfInterest { get; set; } = new();
    private WTLatLng? lastKnownPosition;

    private DateTime? TimeStart { get; set; }
    private DateTime? TimeEnd { get; set; }
    private TimeSpan TimeAccumulated { get; set; } = TimeSpan.Zero;

    private TimeSpan ElapsedTime => TimeAccumulated + (isRecording && TimeStart.HasValue ? (DateTime.UtcNow - TimeStart.Value) : TimeSpan.Zero);

    private string ElapsedTimeDisplay
    {
        get
        {
            var ts = ElapsedTime;
            if (ts.TotalHours >= 1)
                return string.Format("{0}:{1:00}:{2:00}", (int)ts.TotalHours, ts.Minutes, ts.Seconds);
            return string.Format("{0:00}:{1:00}", (int)ts.TotalMinutes, ts.Seconds);
        }
    }

    private DotNetObjectReference<TrailCreate>? dotNetRef;
    private CreateTrailDTO? NewTrail { get; set; }
    private EditContext? editContext;

    private CancellationTokenSource? cts;
    private bool metadataCollapsed = false;

    private string? errorMessage;
    private string? successMessage;
    private bool isSubmitting = false;

    // Wake Lock support
    private bool isWakeLockSupported = false;
    private bool isWakeLockActive = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                var pos = await JS.InvokeAsync<Geoposition>("getCurrentPosition");
                await JS.InvokeVoidAsync("initMap", dotNetRef, "map", pos.lat, pos.lng, 16);
            }
            catch
            {
                await JS.InvokeVoidAsync("initMap", dotNetRef, "map", 51.5074, -0.1278, 14);
            }

            FabService.OnFabAction += HandleFabAction;
            FabService.Show();

            // Check Wake Lock API support
            try
            {
                isWakeLockSupported = await JS.InvokeAsync<bool>("isWakeLockSupported");
                if (isWakeLockSupported)
                {
                    Console.WriteLine("Wake Lock API is supported");
                }
                else
                {
                    Console.WriteLine("Wake Lock API is not supported in this browser");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error checking Wake Lock support: {ex.Message}");
                isWakeLockSupported = false;
            }

            // Load persisted POIs
            try
            {
                var persisted = await JS.InvokeAsync<WTPointOfInterest[]?>("poiStorage.getAllPois");
                if (persisted != null)
                {
                    foreach (var p in persisted)
                    {
                        PointsOfInterest.Add(p);
                        await JS.InvokeVoidAsync("addPoiMarker", p);
                    }
                }
            }
            catch { }
        }
    }

    protected override void OnInitialized()
    {
        NewTrail = new CreateTrailDTO();
        editContext = new EditContext(NewTrail);
    }

    private void HandleFabAction(FabAction action)
    {
        InvokeAsync(async () =>
        {
            switch (action)
            {
                case FabAction.ToggleRecording:
                    await ToggleRecording();
                    break;
                case FabAction.AddPoi:
                    await AddPoi();
                    break;
                case FabAction.SubmitTrail:
                    await SubmitTrail();
                    break;
            }
        });
    }

    private async Task ToggleRecording()
    {
        if (!isRecording)
        {
            showRecordingConfirm = true;
            StateHasChanged();
            return;
        }

        await StopRecordingAsync();
    }

    private async Task StartRecordingAsync()
    {
        showRecordingConfirm = false;
        isRecording = true;
        errorMessage = null;

        if (!TimeStart.HasValue && TimeAccumulated == TimeSpan.Zero)
        {
            Waypoints.Clear();
            PointsOfInterest.Clear();
        }

        TimeStart = DateTime.UtcNow;
        TimeEnd = null;

        // Request wake lock to keep screen awake during recording
        if (isWakeLockSupported)
        {
            try
            {
                var wakeLockAcquired = await JS.InvokeAsync<bool>("requestWakeLock");
                if (wakeLockAcquired)
                {
                    isWakeLockActive = true;
                    Console.WriteLine("Wake lock acquired - screen will stay awake");
                }
                else
                {
                    Console.WriteLine("Wake lock request failed - screen may sleep");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error requesting wake lock: {ex.Message}");
            }
        }

        await JS.InvokeVoidAsync("startWatchPosition", dotNetRef, new { enableHighAccuracy = true, maximumAge = 0, timeout = 5000 });
        showRecordingBanner = true;
        StateHasChanged();
    }

    private async Task StopRecordingAsync()
    {
        isRecording = false;
        await JS.InvokeVoidAsync("stopWatchPosition");

        // Release wake lock when stopping recording
        if (isWakeLockActive)
        {
            try
            {
                await JS.InvokeVoidAsync("releaseWakeLock");
                isWakeLockActive = false;
                Console.WriteLine("Wake lock released - screen can sleep normally");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error releasing wake lock: {ex.Message}");
            }
        }

        TimeEnd = DateTime.UtcNow;
        if (TimeStart.HasValue)
        {
            TimeAccumulated += (TimeEnd.Value - TimeStart.Value);
            TimeStart = null;
        }

        showRecordingBanner = false;

        if (Waypoints.Count > 0)
        {
            var start = Waypoints.First();
            var end = Waypoints.Last();

            NewTrail = new CreateTrailDTO
            {
                Start = start,
                End = end,
                Waypoints = Waypoints.ToList(),
                PointsOfInterest = PointsOfInterest.ToList(),
                Description = NewTrail?.Description ?? "Recorded trail",
                Title = NewTrail?.Title ?? "Recorded Trail",
                Difficulty = NewTrail?.Difficulty ?? "EASY",
            };

            editContext = new EditContext(NewTrail);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPositionUpdate(Geoposition geoPos)
    {
        var point = new WTLatLng(geoPos.lat, geoPos.lng, geoPos.altitude, geoPos.timestamp);
        lastKnownPosition = point;
        Waypoints.Add(point);
        await JS.InvokeVoidAsync("updateTrailPath", Waypoints);
        StateHasChanged();
    }

    private async Task AddPoi()
    {
        if (lastKnownPosition is null) return;
        var poi = new WTPointOfInterest(lastKnownPosition, "VIEW", "");
        PointsOfInterest.Add(poi);
        await JS.InvokeVoidAsync("addPoiMarker", poi);
        StateHasChanged();
    }

    private async Task OnPoiSave(WTPointOfInterest poi)
    {
        poiEditorOpen = false; // if using editor
        editingPoi = null;
        await JS.InvokeVoidAsync("updatePoiMarker", poi);
        try { await JS.InvokeVoidAsync("poiStorage.savePoi", poi); } catch { }
        StateHasChanged();
    }

    private WTPointOfInterest? editingPoi;
    private bool poiEditorOpen = false;

    private async Task DeletePoi(WTPointOfInterest poi)
    {
        PointsOfInterest.Remove(poi);
        try { await JS.InvokeVoidAsync("removePoiMarker", poi.Id); } catch { }
        try { await JS.InvokeVoidAsync("poiStorage.deletePoi", poi.Id); } catch { }
        StateHasChanged();
    }

    private void GoToSettingsFromModal()
    {
        showRecordingConfirm = false;
        NavigationManager.NavigateTo("/account/identity/settings");
    }

    private Task OnPoiCancel()
    {
        poiEditorOpen = false;
        editingPoi = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task EditPoi(WTPointOfInterest poi)
    {
        editingPoi = poi;
        poiEditorOpen = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task SubmitTrail()
    {
        errorMessage = null;
        successMessage = null;

        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            if (Waypoints.Count < 2)
            {
                errorMessage = "Please record at least two points (start and end) before submitting.";
                return;
            }

            // ensure NewTrail exists and is up to date
            if (NewTrail == null)
            {
                var start = Waypoints.First();
                var end = Waypoints.Last();
                NewTrail = new CreateTrailDTO
                {
                    Start = start,
                    End = end,
                    Waypoints = Waypoints.ToList(),
                    PointsOfInterest = PointsOfInterest.ToList(),
                    Title = "Recorded Trail",
                    Description = "Recorded trail",
                    Difficulty = "EASY",
                };
                editContext = new EditContext(NewTrail);
            }

            // update route-related fields and compute length
            NewTrail.Start = Waypoints.First();
            NewTrail.End = Waypoints.Last();
            NewTrail.Waypoints = Waypoints.ToList();
            NewTrail.PointsOfInterest = PointsOfInterest.ToList();

            double lengthMeters = 0;
            for (int i = 0; i < Waypoints.Count - 1; i++)
            {
                lengthMeters += CalculateDistance(Waypoints[i], Waypoints[i + 1]);
            }
            NewTrail.LengthMeters = lengthMeters;
            
            // Build elevation profile from waypoint altitudes
            NewTrail.ElevationProfile = Waypoints
                .Where(w => w.Altitude.HasValue)
                .Select(w => w.Altitude!.Value)
                .ToList();
            
            if (NewTrail.ElevationProfile.Count == 0)
            {
                NewTrail.ElevationProfile = new List<double>();
            }

            // create cancellation token source
            cts = new CancellationTokenSource();
            var response = await AccountService.CreateTrailAsync(NewTrail, cts.Token);

            if (response.Success)
            {
                successMessage = $"Trail '{response.Trail?.Title}' created successfully!";

                try
                {
                    foreach (var poi in PointsOfInterest)
                    {
                        await JS.InvokeVoidAsync("poiStorage.deletePoi", poi.Id);
                    }
                }
                catch { }

                Waypoints.Clear();
                PointsOfInterest.Clear();
                TimeAccumulated = TimeSpan.Zero;
                var createdId = response.Trail?.Id ?? Guid.Empty;
                NewTrail = null;
                editContext = null;
                lastKnownPosition = null;

                if (createdId != Guid.Empty)
                {
                    NavigationManager.NavigateTo($"/trails/{createdId}/photos");
                }
                else
                {
                    NavigationManager.NavigateTo("/trails");
                }
            }
            else
            {
                errorMessage = response.Message ?? "Failed to create trail. Please try again.";
            }
        }
        catch (OperationCanceledException)
        {
            errorMessage = "Trail submission was cancelled.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Network error. Please check your connection and try again.";
            Console.WriteLine($"Network error in SubmitTrail: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            Console.WriteLine($"Error in SubmitTrail: {ex}");
        }
        finally
        {
            try { cts?.Dispose(); } catch { }
            cts = null;
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void CancelSubmit()
    {
        cts?.Cancel();
    }

    private string LastPositionDisplay => lastKnownPosition is null ? "N/A" : string.Format("{0:F5}, {1:F5}", lastKnownPosition.Lat, lastKnownPosition.Lng);

    public void Dispose()
    {
        dotNetRef?.Dispose();
        FabService.OnFabAction -= HandleFabAction;
        FabService.Hide();

        // Ensure wake lock is released when component is disposed
        if (isWakeLockActive)
        {
            try
            {
                // Fire and forget - don't await in Dispose
                _ = JS.InvokeVoidAsync("releaseWakeLock");
                isWakeLockActive = false;
            }
            catch
            {
                // Ignore errors during dispose
            }
        }
    }

    private double CalculateDistance(WTLatLng point1, WTLatLng point2)
    {
        const double R = 6371000; // Earth's radius in meters
        var lat1Rad = point1.Lat * Math.PI / 180;
        var lat2Rad = point2.Lat * Math.PI / 180;
        var deltaLat = (point2.Lat - point1.Lat) * Math.PI / 180;
        var deltaLng = (point2.Lng - point1.Lng) * Math.PI / 180;

        var a = Math.Sin(deltaLat / 2) * Math.Sin(deltaLat / 2) + Math.Cos(lat1Rad) * Math.Cos(lat2Rad) * Math.Sin(deltaLng / 2) * Math.Sin(deltaLng / 2);
        var c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));

        return R * c;
    }

