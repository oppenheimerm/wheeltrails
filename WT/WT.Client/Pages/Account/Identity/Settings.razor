@page "/account/identity/settings"

@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage

@using Microsoft.AspNetCore.Authorization
@using System.Linq.Expressions
@using WT.Application.DTO.Response.Account
@using WT.Application.Extensions
@using WT.Domain.Enums

<PageTitle>WheelyTrails - Account Settings</PageTitle>
@attribute [Authorize(Roles = Constants.Role.USER)]

@code {
    private ApplicationUserDTO? ModelDTO { get; set; }
    private AuthenticatedSessionDTO? LocalStorageDTO { get; set; }
    private APIResponseUserSettingsDTO? AuthenticateUserQuery { get; set; }
    private EditContext? editContext;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private List<CountryCode> countryCodes = [];

    // New: profile photo url loaded from local storage (NavBarSettings)
    private string? profilePhotoUrl;

    // Local storage key for recording preferences fallback (for unauthenticated testing)
    private const string RecordingPrefsLocalStorageKey = "RecordingPreferences";

    // Selected int value for dropdown binding (synchronizes to AuthenticateUserQuery.GpsAccuracy)
    private int SelectedGpsAccuracy
    {
        get => (int)(AuthenticateUserQuery?.GpsAccuracy ?? GpsAccuracyLevel.Default);
        set
        {
            if (AuthenticateUserQuery == null) AuthenticateUserQuery = new APIResponseUserSettingsDTO();
            AuthenticateUserQuery.GpsAccuracy = (GpsAccuracyLevel)value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        countryCodes = StringHelpers.GetCountryCodes();
        await LoadUserData();
    }

    private async Task LoadUserData()
    {
        try
        {
            isLoading = true;
            //LocalStorageDTO = await AccountService.GetAuthenticatedLocalStorageAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                NavigationManager.NavigateTo("/account/identity/login");
                return;
            }

            // Get user ID from claims
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !Guid.TryParse(userIdClaim.Value, out var userId))
            {
                errorMessage = "Unable to identify user.";
                return;
            }

            // TODO: Fetch user data from API
            // For now, create from claims
            ModelDTO = new ApplicationUserDTO
            {
                Id = userId,
                FirstName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value,
                Email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value,
                // TODO: Fetch from API: ProfileUsername, ProfileUsernameCreatedAt, Bio, CountryCode
            };

            // QUICK UI: try to load non-sensitive navbar/session data from local storage first so UI shows immediately
            try
            {
                var navBarLocalStorageKey = Configuration["ApplicationSettings:NavBarSettings"];
                if (!string.IsNullOrEmpty(navBarLocalStorageKey))
                {
                    var cached = await LocalStorage.GetItemAsync<AuthenticatedSessionDTO?>(navBarLocalStorageKey);
                    if (cached != null)
                    {
                        AuthenticateUserQuery ??= new APIResponseUserSettingsDTO();
                        AuthenticateUserQuery.FirstName = cached.FirstName ?? AuthenticateUserQuery.FirstName;
                        AuthenticateUserQuery.Email = cached.Email ?? AuthenticateUserQuery.Email;
                        AuthenticateUserQuery.ProfileUsername = cached.ProfileUsername ?? AuthenticateUserQuery.ProfileUsername;
                        AuthenticateUserQuery.ProfilePicture = cached.UserPhoto ?? AuthenticateUserQuery.ProfilePicture;
                        AuthenticateUserQuery.Bio = cached.Bio ?? AuthenticateUserQuery.Bio;
                        // AuthenticatedSessionDTO does not contain CountryCode - skip
                        AuthenticateUserQuery.GpsAccuracy = cached.GpsAccuracy;
                        AuthenticateUserQuery.ShowRecordingWarning = cached.ShowRecordingWarning;

                        profilePhotoUrl = cached.UserPhoto != null ? cached.UserPhoto + $"?v={Guid.NewGuid()}" : profilePhotoUrl;
                    }
                }
            }
            catch { /* ignore local storage errors - UI will refresh after API call */ }

            // Fetch this authenticated user's account settings (refresh from server)
            var userQuery = await AccountService.GetAccountSettingsAsync();
            // Success?
            if (userQuery.Success)
            {
                AuthenticateUserQuery = userQuery.UserSettings;
                Console.WriteLine("User authenticated");
            }
            else
            {
                // Write to consolde that authtnrtication failed
                Console.WriteLine("Failed to fetch account settings");
                //NavigationManager.NavigateTo("/account/identity/login", true);
            }

            // If server didn't provide recorder prefs (or for quick local testing), try local storage
            if (AuthenticateUserQuery == null)
            {
                AuthenticateUserQuery = new APIResponseUserSettingsDTO();
            }

            // Try to merge local recording prefs (useful for testing without full backend)
            try
            {
                var localPrefs = await LocalStorage.GetItemAsync<RecordingPreferences?>(RecordingPrefsLocalStorageKey);
                if (localPrefs != null)
                {
                    // only override if values are not null / default
                    AuthenticateUserQuery.GpsAccuracy = localPrefs.GpsAccuracy;
                    AuthenticateUserQuery.ShowRecordingWarning = localPrefs.ShowRecordingWarning;
                }
            }
            catch (Exception) { /* ignore local storage read errors */ }

            // Load profile photo from local storage (NavBarSettings)
            try
            {
                var navBarLocalStorageKey = Configuration["ApplicationSettings:NavBarSettings"];
                if (!string.IsNullOrEmpty(navBarLocalStorageKey))
                {
                    // Ensure navbar auth data is refreshed (same approach as NavBar)
                    await AccountService.SetNavBarAuthDataAsync();

                    var navBarAuthData = await LocalStorage.GetItemAsync<AuthenticatedSessionDTO>(navBarLocalStorageKey);
                    profilePhotoUrl = navBarAuthData?.UserPhoto + $"?v={Guid.NewGuid()}";
                    ;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load profile photo from local storage: {ex.Message}");
            }

            editContext = new EditContext(ModelDTO);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
            errorMessage = "Failed to load user settings.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting || ModelDTO == null) return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            // TODO: Implement update user endpoint
            // var response = await AccountService.UpdateUserAsync(ModelDTO);

            // if (response.Success)
            // {
            //     successMessage = "Settings updated successfully!";
            // }
            // else
            // {
            //     errorMessage = response.Message;
            // }

            // Temporary success message
            await Task.Delay(500);
            successMessage = "Settings updated successfully!";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating settings: {ex.Message}");
            errorMessage = "Failed to update settings. Please try again.";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("❌ HandleInvalidSubmit called - form has validation errors");

        if (editContext != null)
        {
            var errors = editContext.GetValidationMessages();
            foreach (var error in errors)
            {
                Console.WriteLine($"  - {error}");
            }
        }
    }

    private bool HasValidationErrors(Expression<Func<string?>> accessor)
    {
        if (editContext == null) return false;

        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private string GetInputClass(Expression<Func<string?>> accessor)
    {
        return HasValidationErrors(accessor) ? "wt-form-input-error" : "wt-form-input";
    }

    private string FormatJoinedDate(DateTime? date)
    {
        if (date == null) return "Unknown";
        return date.Value.ToString("MMMM yyyy");
    }

    // Navigation helper for change photo button
    private void GoToUploadPhoto()
    {
        NavigationManager.NavigateTo("/account/identity/upload-photo");
    }

    // Recording preferences local model (used for localStorage fallback)
    private record RecordingPreferences(GpsAccuracyLevel GpsAccuracy, bool ShowRecordingWarning);

    private async Task SaveRecordingPreferencesAsync()
    {
        try
        {
            if (AuthenticateUserQuery == null) return;

            // Persist to local storage for quick feedback/testing
            var prefs = new RecordingPreferences(AuthenticateUserQuery.GpsAccuracy, AuthenticateUserQuery.ShowRecordingWarning);
            await LocalStorage.SetItemAsync(RecordingPrefsLocalStorageKey, prefs);

            // TODO: Optionally call an API to persist server-side when endpoint exists
            successMessage = "Recorder preferences saved.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to save recording preferences: {ex.Message}");
            errorMessage = "Failed to save preferences.";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ResetLocalPrefsAsync()
    {
        try
        {
            await LocalStorage.RemoveItemAsync(RecordingPrefsLocalStorageKey);
            successMessage = "Recording preferences reset.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to reset local prefs: {ex.Message}");
            errorMessage = "Failed to reset local preferences.";
        }
        finally
        {
            StateHasChanged();
        }
    }
}

<div class="mt-[96.8px] min-h-screen bg-harp-50 dark:bg-harp-950">
    <div class="container mx-auto px-4 py-8 max-w-4xl">
        
        @if (isLoading)
        {
            <div class="flex justify-center items-center py-20">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-harp-600"></div>
            </div>
        }
        else if (ModelDTO == null)
        {
            <div class="bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 p-4 rounded-lg">
                <p class="font-medium">Error loading user data. Please try refreshing the page.</p>
            </div>
        }
        else
        {
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-4xl font-bold text-wt-black-900 dark:text-white mb-2">Account Settings</h1>
                <p class="text-gray-600 dark:text-gray-400">Manage your account information and preferences</p>
            </div>

            <!-- Profile Photo & Action (outside EditForm) -->
            <AuthorizeView>
                <Authorized>
                    <div class="mb-6 flex items-center gap-6">
                        <div>
                            @if (!string.IsNullOrEmpty(profilePhotoUrl))
                            {
                                <img src="@profilePhotoUrl" alt="Profile photo" class="w-28 h-28 rounded-full object-cover border-4 border-[var(--md-sys-color-outline-variant)] shadow-elevation-2" />
                            }
                            else
                            {
                                <div class="w-28 h-28 rounded-full bg-harp-100 dark:bg-harp-900 flex items-center justify-center text-gray-400 border-2">
                                    <span class="material-symbols-rounded text-5xl">account_circle</span>
                                </div>
                            }
                        </div>

                        <div class="flex flex-col">
                            <button @onclick="GoToUploadPhoto" class="wt-btn-primary flex items-center gap-2">
                                <span class="material-symbols-rounded">photo_camera</span>
                                <span>Change Photo</span>
                            </button>
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Accepted formats: .jpg, .png, .svg —200×200px recommended. Max3 MB.</p>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

            <!-- Success/Error Messages -->
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="mb-6 p-4 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-lg flex items-center">
                    <span class="material-symbols-rounded mr-2">check_circle</span>
                    @successMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-lg flex items-center">
                    <span class="material-symbols-rounded mr-2">error</span>
                    @errorMessage
                </div>
            }

            <!-- Settings Card -->
            <div class="bg-white dark:bg-harp-900 rounded-2xl shadow-lg p-6 md:p-8">
                <EditForm OnValidSubmit="HandleValidSubmit"
                          OnInvalidSubmit="HandleInvalidSubmit"
                          EditContext="editContext">
                    <DataAnnotationsValidator />

                    <div class="space-y-8">
                        
                        <!-- Personal Information Section -->
                        <div>
                            <h2 class="text-2xl font-semibold text-wt-black-900 dark:text-white mb-6 pb-3 border-b border-gray-200 dark:border-harp-700">
                                Personal Information
                            </h2>

                            <div class="grid md:grid-cols-2 gap-6">
                                <!-- First Name (Editable) -->
                                <div>
                                    <label class="wt-form-lbl" for="firstName">First Name</label>
                                    <div class="relative flex items-center">
                                        <InputText @bind-Value="AuthenticateUserQuery!.FirstName"
                                                   id="firstName"
                                                   class="@GetInputClass(() => ModelDTO.FirstName)"
                                                   placeholder="Enter your first name" />
                                        <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                            <span class="material-symbols-rounded text-[18px]">person</span>
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => AuthenticateUserQuery.FirstName)" class="wt-form-error-msg" />
                                </div>

                                <!-- Profile Username (Read-only) -->
                                <div>
                                    <label class="wt-form-lbl" for="profileUsername">
                                        Username
                                        <span class="text-xs text-gray-500 dark:text-gray-400 ml-2">(Cannot be changed)</span>
                                    </label>
                                    <div class="relative flex items-center">
                                        <InputText @bind-Value="AuthenticateUserQuery.ProfileUsername"
                                                   id="profileUsername"
                                                   class="wt-form-input opacity-60 cursor-not-allowed !pl-[28px]"
                                                   placeholder="username"
                                                   readonly="readonly"
                                                   disabled="true" />
                                        <span class="absolute left-3 top-3 text-gray-500 dark:text-gray-400">@@</span>
                                        <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                            <span class="material-symbols-rounded text-[18px]">alternate_email</span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                        Your unique username is permanent and cannot be modified.
                                    </p>
                                </div>

                                <!-- Email (Read-only) -->
                                <div>
                                    <label class="wt-form-lbl" for="email">Email Address</label>
                                    <div class="relative flex items-center">
                                        <InputText @bind-Value="AuthenticateUserQuery.Email"
                                                   id="email"
                                                   class="wt-form-input opacity-60 cursor-not-allowed"
                                                   placeholder="email@example.com"
                                                   readonly="readonly"
                                                   disabled="true" />
                                        <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                            <span class="material-symbols-rounded text-[18px]">mail</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Joined Date (Read-only) -->
                                <div>
                                    <label class="wt-form-lbl" for="joinedDate">Member Since</label>
                                    <div class="relative flex items-center">
                                        <input type="text"
                                               id="joinedDate"
                                               class="wt-form-input opacity-60 cursor-not-allowed"
                                               value="@FormatJoinedDate(AuthenticateUserQuery.MemberSince)"
                                               readonly="readonly"
                                               disabled="true" />
                                        <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                            <span class="material-symbols-rounded text-[18px]">calendar_today</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Recorder Preferences Section -->
                        <div>
                            <h2 class="text-2xl font-semibold text-wt-black-900 dark:text-white mb-6 pb-3 border-b border-gray-200 dark:border-harp-700">
                                Recorder Preferences
                            </h2>

                            <div class="space-y-4">
                                <!-- GPS Accuracy (dropdown) -->
                                <div>
                                    <label class="wt-form-lbl" for="gpsAccuracy">GPS Accuracy</label>
                                    <div class="relative">
                                        <InputSelect @bind-Value="SelectedGpsAccuracy"
                                                     id="gpsAccuracy"
                                                     class="wt-form-input-dd">
                                            <option value="">Select GPS accuracy</option>
                                            @foreach (var level in Enum.GetValues<GpsAccuracyLevel>())
                                            {
                                                <option value="@((int)level)">@level</option>
                                            }
                                        </InputSelect>
                                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                            <span class="material-symbols-rounded text-[18px] text-gray-500 dark:text-gray-400">recenter</span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-[var(--md-sys-color-on-surface-variant)] mt-2">High accuracy gives better trails but may reduce battery life.</p>
                                </div>

                                <!-- Show recording warning toggle -->
                                <div class="flex items-center justify-between">
                                    <div>
                                        <label class="wt-form-lbl">Show recording warning</label>
                                        <p class="text-xs text-[var(--md-sys-color-on-surface-variant)]">Show a confirmation before starting recording to warn about battery usage.</p>
                                    </div>
                                    <div>
                                        <label class="switch">
                                            <input type="checkbox" @bind="AuthenticateUserQuery.ShowRecordingWarning" />
                                            <span class="slider round"></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="flex gap-3">
                                    <button type="button" class="wt-btn" @onclick="SaveRecordingPreferencesAsync">Save preferences</button>
                                    <button type="button" class="wt-btn-outline" @onclick="ResetLocalPrefsAsync">Reset local prefs</button>
                                </div>
                            </div>
                        </div>

                        <!-- Bio Section -->
                        <div>
                            <h2 class="text-2xl font-semibold text-wt-black-900 dark:text-white mb-6 pb-3 border-b border-gray-200 dark:border-harp-700">
                                About You
                            </h2>

                            <div>
                                <label class="wt-form-lbl" for="bio">Bio (Optional)</label>
                                <InputTextArea @bind-Value="AuthenticateUserQuery.Bio"
                                               id="bio"
                                               class="@GetInputClass(() => ModelDTO.Bio)"
                                               placeholder="Tell us about yourself and your love for trails... (max500 characters)"
                                               rows="4" />
                                <div class="flex justify-between items-center mt-1">
                                    <ValidationMessage For="@(() => AuthenticateUserQuery.Bio)" class="wt-form-error-msg" />
                                    <span class="text-xs text-gray-500 dark:text-gray-400">
                                        @((ModelDTO.Bio?.Length ??0)) /500 characters
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Location Section -->
                        <div>
                            <h2 class="text-2xl font-semibold text-wt-black-900 dark:text-white mb-6 pb-3 border-b border-gray-200 dark:border-harp-700">
                                Location
                            </h2>

                            <div>
                                <label class="wt-form-lbl" for="countryCode">Country</label>
                                <div class="relative flex items-center">
                                    <InputSelect @bind-Value="AuthenticateUserQuery.CountryCode"
                                                 id="countryCode"
                                                 class="@(HasValidationErrors(() => AuthenticateUserQuery.CountryCode) ? "wt-form-input-dd-error" : "wt-form-input-dd")">
                                        <option value="">Select your country</option>
                                        @foreach (var countryCode in countryCodes)
                                        {
                                            <option value="@countryCode.Code">@countryCode.Name</option>
                                        }
                                    </InputSelect>
                                    <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                        <span class="material-symbols-rounded text-[18px]">public</span>
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.CountryCode)" class="wt-form-error-msg" />
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-4 pt-6 border-t border-gray-200 dark:border-harp-700">
                            <button type="submit"
                                    class="flex-1 py-3 px-6 text-[15px] font-medium tracking-wide rounded-lg text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 cursor-pointer transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center"
                                    disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="animate-spin mr-2">⏳</span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span class="material-symbols-rounded mr-2 text-[20px]">save</span>
                                    <span>Save Changes</span>
                                }
                            </button>

                            <button type="button"
                                    @onclick="LoadUserData"
                                    class="flex-1 sm:flex-none py-3 px-6 text-[15px] font-medium tracking-wide rounded-lg text-gray-700 dark:text-gray-300 bg-gray-200 dark:bg-harp-800 hover:bg-gray-300 dark:hover:bg-harp-700 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 cursor-pointer transition-all flex items-center justify-center">
                                <span class="material-symbols-rounded mr-2 text-[20px]">refresh</span>
                                <span>Reset</span>
                            </button>
                        </div>

                    </div>
                </EditForm>
            </div>

            <!-- Additional Settings Links -->
            <div class="mt-8 grid md:grid-cols-3 gap-4">
                <a href="/account/identity/change-password" class="block p-6 bg-white dark:bg-harp-900 rounded-xl shadow-md hover:shadow-lg transition-shadow">
                    <div class="flex items-start">
                        <span class="material-symbols-rounded text-[32px] text-harp-600 dark:text-harp-400 mr-4">lock</span>
                        <div>
                            <h3 class="font-semibold text-wt-black-900 dark:text-white mb-1">Change Password</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Update your password and security settings</p>
                        </div>
                    </div>
                </a>

                <a href="/account/privacy" class="block p-6 bg-white dark:bg-harp-900 rounded-xl shadow-md hover:shadow-lg transition-shadow">
                    <div class="flex items-start">
                        <span class="material-symbols-rounded text-[32px] text-harp-600 dark:text-harp-400 mr-4">shield</span>
                        <div>
                            <h3 class="font-semibold text-wt-black-900 dark:text-white mb-1">Privacy Settings</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Manage your privacy and data preferences</p>
                        </div>
                    </div>
                </a>

                <a href="/account/notifications" class="block p-6 bg-white dark:bg-harp-900 rounded-xl shadow-md hover:shadow-lg transition-shadow">
                    <div class="flex items-start">
                        <span class="material-symbols-rounded text-[32px] text-harp-600 dark:text-harp-400 mr-4">notifications</span>
                        <div>
                            <h3 class="font-semibold text-wt-black-900 dark:text-white mb-1">Notifications</h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">Customize your notification preferences</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

