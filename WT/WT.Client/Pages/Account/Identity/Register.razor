@page "/account/identity/register"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Linq.Expressions
@using WT.Application.Extensions
@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@implements IDisposable

<PageTitle>WheelyTrails - Register</PageTitle>

@code {
    private RegisterDTO ModelDTO { get; set; } = new();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    private bool isSubmitting = false;
    private bool isCheckingUsername = false;
    private bool isUsernameAvailable = false;
    private string usernameAvailabilityMessage = string.Empty;
    private string? errorMessage = string.Empty;
    private string? successMessage;
    private System.Threading.Timer? usernameCheckTimer;

    // Password visibility (JS interop toggles input type)
    private bool isPasswordVisible = false;
    private bool isConfirmPasswordVisible = false;

    // Password strength indicator
    private int passwordScore = 0; // 0..4
    private string passwordStrengthLabel = "Too short";

    // Cache country codes to avoid calling method during render
    private List<CountryCode> countryCodes = new List<CountryCode>();

    protected override void OnInitialized()
    {
        editContext = new EditContext(ModelDTO);
        messageStore = new ValidationMessageStore(editContext);
        countryCodes = StringHelpers.GetCountryCodes();
        Console.WriteLine("Register page initialized");
    }

    // Use Task-returning handler and explicit lambda in markup to avoid EventCallback overload ambiguity
    private async Task OnUsernameChanged(ChangeEventArgs e)
    {
        var username = e.Value?.ToString()?.Trim();

        usernameCheckTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(username))
        {
            usernameAvailabilityMessage = string.Empty;
            isUsernameAvailable = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (username.Length < 3)
        {
            usernameAvailabilityMessage = "Username must be at least 3 characters";
            isUsernameAvailable = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        usernameCheckTimer = new System.Threading.Timer(async _ =>
        {
            await CheckUsernameAvailability(username);
        }, null, 500, Timeout.Infinite);
    }

    private async Task CheckUsernameAvailability(string username)
    {
        isCheckingUsername = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await AccountService.ValidateProfileUsernameAsync(username);
            isUsernameAvailable = result.IsValid;
            usernameAvailabilityMessage = result.Message ?? "Unknown validation error";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking username: {ex.Message}");
            usernameAvailabilityMessage = "Unable to check username availability";
            isUsernameAvailable = false;
        }
        finally
        {
            isCheckingUsername = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("✅ HandleValidSubmit CALLED!");
        Console.WriteLine($"Name: {ModelDTO.FirstName}");
        Console.WriteLine($"Email: {ModelDTO.Email}");

        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var response = await AccountService.RegisterAsync(ModelDTO);

            Console.WriteLine($"Response received. Success: {response.Success}");

            if (response.Success)
            {
                Console.WriteLine("🎉 Registration successful!");
                var email = ModelDTO.Email ?? string.Empty;
                var encodedEmail = Uri.EscapeDataString(email);
                NavigationManager.NavigateTo($"/account/identity/registration-success?email={encodedEmail}", forceLoad: false);
            }
            else
            {
                errorMessage = response.Message;
                Console.WriteLine($"Registration failed: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception: {ex.Message}");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("❌ HandleInvalidSubmit called - form has validation errors");

        if (editContext != null)
        {
            var errors = editContext.GetValidationMessages();
            foreach (var error in errors)
            {
                Console.WriteLine($"  - {error}");
            }
        }
    }

    private bool HasValidationErrors(Expression<Func<string?>> accessor)
    {
        if (editContext == null) return false;

        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private string GetInputClass(Expression<Func<string?>> accessor)
    {
        return HasValidationErrors(accessor) ? "wt-form-input-error" : "wt-form-input";
    }

    private async Task ShowTermsModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelper.showModal", "default-modal");
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelper.hideModal", "default-modal");
    }

    private async Task AcceptTerms()
    {
        ModelDTO.AcceptTerms = true;
        await CloseModal();
        StateHasChanged();
    }

    private void DeclineTerms()
    {
        ModelDTO.AcceptTerms = false;
        NavigationManager.NavigateTo("/", forceLoad: false);
    }

    // Toggle password visibility using existing themeManager.togglePasswordVisibility
    private async Task TogglePassword()
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<bool>("themeManager.togglePasswordVisibility", "password");
            isPasswordVisible = result;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TogglePassword error: {ex}");
        }
    }

    private async Task ToggleConfirmPassword()
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<bool>("themeManager.togglePasswordVisibility", "confirmPassword");
            isConfirmPasswordVisible = result;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ToggleConfirmPassword error: {ex}");
        }
    }

    // Wrapper property retained for compatibility but not used by password input element anymore
    private string NewPassword
    {
        get => ModelDTO.Password ?? string.Empty;
        set
        {
            ModelDTO.Password = value;
            UpdatePasswordStrength(value);
        }
    }

    // Password strength evaluation
    private void UpdatePasswordStrength(string? pwd)
    {
        passwordScore = CalculatePasswordScore(pwd);
        passwordStrengthLabel = passwordScore switch
        {
            0 => "Too short",
            1 => "Weak",
            2 => "Fair",
            3 => "Good",
            4 => "Strong",
            _ => "Too short"
        };
        StateHasChanged();
    }

    private int CalculatePasswordScore(string? pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        var score = 0;

        if (pwd.Length >= 7) score++;
        if (pwd.Any(char.IsLower)) score++;
        if (pwd.Any(char.IsUpper)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(ch => !char.IsLetterOrDigit(ch))) score++;

        // cap at 4 (we want 0..4)
        return Math.Min(score, 4);
    }

    // Use raw input handler to avoid InputText EventCallback ambiguity and ensure value persists when Blazor re-renders.
    private Task OnPasswordInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? string.Empty;
        ModelDTO.Password = v;
        UpdatePasswordStrength(v);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        usernameCheckTimer?.Dispose();
    }
}
<!-- Page layout: respect Top App Bar offset (pt-16), Material 3 color tokens and Tailwind utilities -->
<div class="min-h-screen pt-16 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">

            <!-- Illustration / image (hidden on small screens) -->
            <div class="hidden md:block rounded-xl overflow-hidden shadow-elevation-2">
                <img src="https://readymadeui.com/image-3.webp"
                     alt="register-image"
                     class="w-full h-[520px] object-cover bg-[var(--md-sys-color-surface-container-lowest)]" />
            </div>

            <!-- Form card -->
            <div class="w-full max-w-xl mx-auto">
                <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)] rounded-xl shadow-elevation-2 p-8">
                    <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-error-container)] text-[var(--md-sys-color-on-error-container)]">
                                @errorMessage
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-primary-container)] text-[var(--md-sys-color-on-primary-container)]">
                                @successMessage
                            </div>
                        }

                        <div class="mb-8">
                            <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Create Account</h1>
                            <p class="mt-2 text-sm text-[var(--md-sys-color-on-surface-variant)]">
                                Already have an account?
                                <a href="/account/identity/login" class="wt-link">Sign in here</a>
                            </p>
                        </div>

                        <div class="space-y-6">
                            <!-- First Name -->
                            <div>
                                <label class="wt-form-lbl" for="firstName">First Name</label>
                                <div class="relative">
                                    <InputText @bind-Value="ModelDTO.FirstName"
                                               id="firstName"
                                               class="@GetInputClass(() => ModelDTO.FirstName)"
                                               placeholder="Enter first name" />
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.FirstName)" />
                            </div>

                            <!-- Username -->
                            <div>
                                <label class="wt-form-lbl" for="profileUsername">
                                    Username <span class="text-red-600">*</span>
                                </label>
                                <div class="relative">
                                    <span class="absolute left-3 top-3 text-[var(--md-sys-color-on-surface-variant)]">@@</span>
                                    <InputText @bind-Value="ModelDTO.ProfileUsername"
                                               id="profileUsername"
                                               class="@($"{GetInputClass(() => ModelDTO.ProfileUsername)} !pl-[28px]")"
                                               placeholder="your_unique_username"
                                               @oninput="@( (ChangeEventArgs e) => OnUsernameChanged(e) )" />
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.ProfileUsername)" />

                                @if (isCheckingUsername)
                                {
                                    <p class="text-sm text-[var(--md-sys-color-on-surface-variant)] mt-1 flex items-center">
                                        <span class="animate-spin mr-2">⏳</span> Checking availability...
                                    </p>
                                }
                                else if (!string.IsNullOrEmpty(usernameAvailabilityMessage))
                                {
                                    <p class="text-sm mt-1 flex items-center @(isUsernameAvailable ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                        <span class="mr-1">@(isUsernameAvailable ? "✓" : "✗")</span>
                                        @usernameAvailabilityMessage
                                    </p>
                                }

                                <p class="text-xs text-[var(--md-sys-color-on-surface-variant)] mt-1">
                                    ⚠️ Choose wisely! Your username cannot be changed after registration.
                                </p>
                                <p class="text-xs text-[var(--md-sys-color-on-surface-variant)] mt-1">
                                    3-20 characters. Letters, numbers, underscores, dashes, and dots only.
                                </p>
                            </div>

                            <!-- Email -->
                            <div>
                                <label class="wt-form-lbl" for="email">Email</label>
                                <div class="relative">
                                    <InputText @bind-Value="ModelDTO.Email"
                                               id="email"
                                               class="@GetInputClass(() => ModelDTO.Email)"
                                               placeholder="Email address" />
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.Email)" />
                            </div>

                            <!-- Bio -->
                            <div>
                                <label class="wt-form-lbl" for="bio">Bio (Optional)</label>
                                <InputTextArea @bind-Value="ModelDTO.Bio"
                                               id="bio"
                                               class="@GetInputClass(() => ModelDTO.Bio)"
                                               placeholder="Tell us about yourself (max 500 characters)"
                                               rows="3" />
                                <ValidationMessage For="@(() => ModelDTO.Bio)" />
                            </div>

                            <!-- Password -->
                            <div>
                                <label class="wt-form-lbl" for="password">Password</label>
                                <div class="relative">
                                    <!-- raw input with explicit handler to avoid clearing when Blazor re-renders -->
                                    <input id="password"
                                           type="password"
                                           value="@ModelDTO.Password"
                                           @oninput="OnPasswordInput"
                                           class="@($"{GetInputClass(() => ModelDTO.Password)} pr-10 w-full")"
                                           placeholder="Enter password (min 7 characters)" />

                                    <button type="button"
                                            @onclick="TogglePassword"
                                            class="absolute inset-y-0 right-0 pr-2 flex items-center text-[var(--md-sys-color-on-surface-variant)]
                                                   bg-transparent rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                            aria-label="Toggle password visibility">
                                        <span class="material-symbols-rounded text-[18px]">
                                            @(isPasswordVisible ? "visibility_off" : "visibility")
                                        </span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.Password)" />

                                <!-- Password strength indicator -->
                                <div class="mt-2">
                                    <div class="h-2 w-full rounded-full bg-[var(--md-sys-color-surface-container-high)] overflow-hidden">
                                        <div style="width:@(passwordScore * 25)%; background-color:@GetStrengthColor(passwordScore); height:100%; transition:width .18s ease-in-out;"></div>
                                    </div>
                                    <p class="text-xs mt-1 text-[var(--md-sys-color-on-surface-variant)]">@passwordStrengthLabel</p>
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div>
                                <label class="wt-form-lbl" for="confirmPassword">Confirm Password</label>
                                <div class="relative">
                                    <InputText @bind-Value="ModelDTO.ConfirmPassword"
                                               type="password"
                                               id="confirmPassword"
                                               class="@($"{GetInputClass(() => ModelDTO.ConfirmPassword)} pr-10")"
                                               placeholder="Confirm password" />
                                    <button type="button"
                                            @onclick="ToggleConfirmPassword"
                                            class="absolute inset-y-0 right-0 pr-2 flex items-center text-[var(--md-sys-color-on-surface-variant)]
                                                   bg-transparent rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                            aria-label="Toggle confirm password visibility">
                                        <span class="material-symbols-rounded text-[18px]">
                                            @(isConfirmPasswordVisible ? "visibility_off" : "visibility")
                                        </span>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.ConfirmPassword)" />
                            </div>

                            <!-- Country Code -->
                            <div>
                                <label class="wt-form-lbl" for="countryCode">Country Code</label>
                                <div class="relative">
                                    <InputSelect @bind-Value="ModelDTO.CountryCode"
                                                 id="countryCode"
                                                 class="@(HasValidationErrors(() => ModelDTO.CountryCode) ? "wt-form-input-dd-error" : "wt-form-input-dd")">
                                        <option value="">Select Country Code</option>
                                        @foreach (var countryCode in countryCodes)
                                        {
                                            <option value="@countryCode.Code">@countryCode.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                                <ValidationMessage For="@(() => ModelDTO.CountryCode)" />
                            </div>

                            <!-- Accept Terms -->
                            <div class="flex items-start">
                                <div class="flex items-center h-5">
                                    <InputCheckbox @bind-Value="ModelDTO.AcceptTerms"
                                                   id="acceptTerms"
                                                   class="w-4 h-4 border border-[var(--md-sys-color-outline)] rounded bg-[var(--md-sys-color-surface)] focus:ring-3 focus:ring-[var(--md-sys-color-primary)] cursor-pointer" />
                                </div>
                                <label for="acceptTerms" class="ml-3 text-sm font-medium text-[var(--md-sys-color-on-surface)] cursor-pointer">
                                    I accept the <a @onclick="ShowTermsModal" @onclick:preventDefault="true" href="#" class="text-[var(--md-sys-color-primary)] hover:underline">Terms and Conditions</a>
                                </label>
                            </div>
                            <ValidationMessage For="@(() => ModelDTO.AcceptTerms)" />
                        </div>

                        <!-- Main modal -->
                        <div id="default-modal" tabindex="-1" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="default-modal-title"
                             class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 md:p-6">
                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-[var(--md-sys-color-on-background)]/40 backdrop-blur-sm" aria-hidden="true"></div>

                            <!-- Modal wrapper (centers dialog, constrains width) -->
                            <div class="relative w-full max-w-2xl">
                                <!-- Modal card: use column flex so header/footer stay visible and body scrolls.
                                     h-[min(80vh,720px)] gives a fixed (bounded) height across viewports. -->
                                <div class="relative bg-[var(--md-sys-color-surface-container-high)] dark:bg-[var(--md-sys-color-surface)]
                                            rounded-xl shadow-elevation-3 border border-[var(--md-sys-color-outline-variant)] flex flex-col h-[min(80vh,720px)] overflow-hidden">
                                    <!-- Header -->
                                    <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-[var(--md-sys-color-outline-variant)]">
                                        <h3 id="default-modal-title" class="text-lg font-medium text-[var(--md-sys-color-on-surface)]">
                                            Terms of Service
                                        </h3>
                                        <button type="button"
                                                @onclick="CloseModal"
                                                class="text-[var(--md-sys-color-on-surface)] bg-transparent hover:bg-[var(--md-sys-color-surface-container-high)] rounded-lg text-sm w-9 h-9 inline-flex justify-center items-center"
                                                data-modal-hide="default-modal" aria-label="Close modal">
                                            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                            <span class="sr-only">Close modal</span>
                                        </button>
                                    </div>

                                    <!-- Body: flex-1 so it expands to available space and becomes scrollable if content overflows -->
                                    <div id="modal-body" class="px-6 py-4 overflow-auto text-[var(--md-sys-color-on-surface-variant)]">
                                        <p class="leading-relaxed">
                                            With less than a month to go before the European Union enacts new consumer
                                            privacy laws for its citizens, companies around the world are updating their
                                            terms of service agreements to comply.
                                        </p>
                                        <p class="leading-relaxed">
                                            The European Union’s General Data Protection Regulation (G.D.P.R.) goes into effect
                                            on May 25 and is meant to ensure a common set of data rights in the European Union.
                                            It requires organizations to notify users as soon as possible of high-risk data
                                            breaches that could personally affect them.
                                        </p>
                                        <p class="leading-relaxed">
                                            With less than a month to go before the European Union enacts new consumer
                                            privacy laws for its citizens, companies around the world are updating their
                                            terms of service agreements to comply.
                                        </p>
                                        <p class="leading-relaxed">
                                            The European Union’s General Data Protection Regulation (G.D.P.R.) goes into effect
                                            on May 25 and is meant to ensure a common set of data rights in the European Union.
                                            It requires organizations to notify users as soon as possible of high-risk data
                                            breaches that could personally affect them.
                                        </p>
                                    </div>

                                    <!-- Footer: fixed inside the card; always visible because body scrolls -->
                                    <div id="modal-footer" class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface-container-high)]">
                                        <button data-modal-hide="default-modal" type="button" @onclick="AcceptTerms"
                                                class="text-white bg-[var(--md-sys-color-primary)] hover:bg-[var(--md-sys-color-primary)] focus:ring-4 focus:ring-[var(--md-sys-color-primary)] shadow-elevation-2 font-medium rounded-md text-sm px-4 py-2">
                                            I accept
                                        </button>
                                        <button data-modal-hide="default-modal" type="button" @onclick="DeclineTerms"
                                                class="text-[var(--md-sys-color-on-surface)] bg-[var(--md-sys-color-surface)] hover:bg-[var(--md-sys-color-surface-container-high)] focus:ring-4 focus:ring-[var(--md-sys-color-outline-variant)] font-medium rounded-md text-sm px-4 py-2">
                                            Decline
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="mt-8">
                            <button type="submit"
                                    class="w-full py-3 px-4 rounded-full text-[var(--md-sys-color-on-primary)] bg-[var(--md-sys-color-primary)]
                                           shadow-elevation-2 hover:shadow-elevation-3 transition transform active:scale-[.995]
                                           focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                    disabled="@isSubmitting">
                                @(isSubmitting ? "Creating Account..." : "Create Account")
                            </button>
                        </div>

                        <div class="my-6 flex items-center gap-4">
                            <hr class="flex-1 border-[var(--md-sys-color-outline)]" />
                            <p class="text-sm text-[var(--md-sys-color-on-surface-variant]">or</p>
                            <hr class="flex-1 border-[var(--md-sys-color-outline)]" />
                        </div>

                        <div class="grid gap-3">
                            <button type="button" class="wt-btn-outline-social">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20px" class="inline" viewBox="0 0 512 512">
                                    <!-- svg content omitted for brevity -->
                                </svg>
                                Continue with Google
                            </button>

                            <button type="button" class="wt-btn-outline-social">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20px" fill="#000" viewBox="0 0 22.773 22.773">
                                    <!-- svg content omitted for brevity -->
                                </svg>
                                Continue with Apple
                            </button>

                            <button type="button" class="wt-btn-outline-social">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20px" fill="#007bff" viewBox="0 0 167.657 167.657">
                                    <!-- svg content omitted for brevity -->
                                </svg>
                                Continue with Facebook
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    // returns CSS color string using MD3 tokens for consistent theming
    private string GetStrengthColor(int score)
    {
        return score switch
        {
            0 or 1 => "var(--md-sys-color-error)",
            2 => "var(--md-sys-color-tertiary)",
            3 => "var(--md-sys-color-secondary)",
            4 => "var(--md-sys-color-primary)",
            _ => "var(--md-sys-color-outline)"
        };
    }
}

