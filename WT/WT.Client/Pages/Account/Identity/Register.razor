@inject IAccountService AccountService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using System.Linq.Expressions
@using WT.Application.Extensions

@page "/account/identity/register"

<PageTitle>WheelyTrails - Register</PageTitle>

@code {
    private RegisterDTO ModelDTO { get; set; } = new();
    private EditContext? editContext;

    private bool isSubmitting = false;
    private bool isCheckingUsername = false;
    private bool isUsernameAvailable = false;
    private string usernameAvailabilityMessage = string.Empty;
    private string? errorMessage = string.Empty;
    private string? successMessage;
    private System.Threading.Timer? usernameCheckTimer;

    // ✅ Cache country codes to avoid calling method during render
    private List<CountryCode> countryCodes = [];

    protected override void OnInitialized()
    {
        editContext = new EditContext(ModelDTO);
        countryCodes = StringHelpers.GetCountryCodes();
        Console.WriteLine("Register page initialized");
    }

    private async void OnUsernameChanged(ChangeEventArgs e)
    {
        var username = e.Value?.ToString()?.Trim();

        usernameCheckTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(username))
        {
            usernameAvailabilityMessage = string.Empty;
            isUsernameAvailable = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (username.Length < 3)
        {
            usernameAvailabilityMessage = "Username must be at least 3 characters";
            isUsernameAvailable = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        usernameCheckTimer = new System.Threading.Timer(async _ =>
        {
            await CheckUsernameAvailability(username);
        }, null, 500, Timeout.Infinite);
    }

    private async Task CheckUsernameAvailability(string username)
    {
        isCheckingUsername = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // ✅ NEW: Combined validation (availability + profanity)
            var result = await AccountService.ValidateProfileUsernameAsync(username);
            isUsernameAvailable = result.IsValid;
            usernameAvailabilityMessage = result.Message ?? "Unknown validation error";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking username: {ex.Message}");
            usernameAvailabilityMessage = "Unable to check username availability";
            isUsernameAvailable = false;
        }
        finally
        {
            isCheckingUsername = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("✅ HandleValidSubmit CALLED!");
        Console.WriteLine($"Name: {ModelDTO.FirstName}");
        Console.WriteLine($"Email: {ModelDTO.Email}");

        if (isSubmitting) return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var response = await AccountService.RegisterAsync(ModelDTO);

            Console.WriteLine($"Response received. Success: {response.Success}");

            if (response.Success)
            {
                Console.WriteLine("🎉 Registration successful!");

                // ✅ Fix null reference warning
                var email = ModelDTO.Email ?? string.Empty;
                var encodedEmail = Uri.EscapeDataString(email);
                NavigationManager.NavigateTo($"/account/identity/registration-success?email={encodedEmail}", forceLoad: false);
            }
            else
            {
                errorMessage = response.Message;
                Console.WriteLine($"Registration failed: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("❌ HandleInvalidSubmit called - form has validation errors");

        if (editContext != null)
        {
            var errors = editContext.GetValidationMessages();
            foreach (var error in errors)
            {
                Console.WriteLine($"  - {error}");
            }
        }
    }

    private bool HasValidationErrors(Expression<Func<string?>> accessor)
    {
        if (editContext == null) return false;

        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private string GetInputClass(Expression<Func<string?>> accessor)
    {
        return HasValidationErrors(accessor) ? "wt-form-input-error" : "wt-form-input";
    }

    private async Task ShowTermsModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelper.showModal", "default-modal");
    }

    private async Task CloseModal()
    {
        await JSRuntime.InvokeVoidAsync("modalHelper.hideModal", "default-modal");
    }

    private async Task AcceptTerms()
    {
        ModelDTO.AcceptTerms = true;
        await CloseModal();
        StateHasChanged();  // ❌ Should be StateHasChanged()
    }

    private void DeclineTerms()
    {
        ModelDTO.AcceptTerms = false;
        NavigationManager.NavigateTo("/", forceLoad: false);
    }

    public void Dispose()
    {
        usernameCheckTimer?.Dispose();
    }
}

<div class="mt-[96.8px]">
    <div class="grid lg:grid-cols-2 md:grid-cols-2 items-center gap-4 bg-harp-200 dark:bg-harp-950">
        <div class="max-md:order-1 h-screen min-h-full">
            <img src="https://readymadeui.com/image-3.webp" class="w-full h-full object-cover" alt="register-image" />
        </div>

        <div class="max-w-xl w-full p-6 mx-auto text-wt-black-950 dark:text-white">
            <EditForm OnValidSubmit="HandleValidSubmit"
                      OnInvalidSubmit="HandleInvalidSubmit"
                      EditContext="editContext">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 p-3 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="mb-4 p-3 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded">
                        @successMessage
                    </div>
                }

                <div class="mb-12">
                    <h1 class="text-4xl font-bold text-wt-black-900 dark:text-white">Create Account</h1>
                    <p class="text-base mt-6 font-medium">Already have an account? <a href="/account/identity/login" class="wt-link">Sign in here</a></p>
                </div>

                <div class="space-y-6">
                    <!-- First Name -->
                    <div>
                        <label class="wt-form-lbl" for="firstName">First Name</label>
                        <div class="relative flex items-center">
                            <InputText @bind-Value="ModelDTO.FirstName"
                                       id="firstName"
                                       class="@GetInputClass(() => ModelDTO.FirstName)"
                                       placeholder="Enter first name" />
                            <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">person</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.FirstName)" />
                    </div>

                    <!-- Username -->
                    <div>
                        <label class="wt-form-lbl" for="profileUsername">
                            Username <span class="text-red-600">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-3 top-3 text-gray-500 dark:text-gray-400">@@</span>
                            <InputText @bind-Value="ModelDTO.ProfileUsername" 
                                       id="profileUsername"
                                       class="@($"{GetInputClass(() => ModelDTO.ProfileUsername)} !pl-[28px]")"
                                       placeholder="your_unique_username"
                                       @oninput="OnUsernameChanged" />
                            <div class="w-[18px] h-[18px] absolute right-2 top-3 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">alternate_email</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.ProfileUsername)" />

                        @if (isCheckingUsername)
                        {
                            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 flex items-center">
                                <span class="animate-spin mr-2">⏳</span> Checking availability...
                            </p>
                        }
                        else if (!string.IsNullOrEmpty(usernameAvailabilityMessage))
                        {
                            <p class="text-sm mt-1 flex items-center @(isUsernameAvailable ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                <span class="mr-1">@(isUsernameAvailable ? "✓" : "✗")</span>
                                @usernameAvailabilityMessage
                            </p>
                        }

                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                            ⚠️ Choose wisely! Your username cannot be changed after registration.
                        </p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                            3-20 characters. Letters, numbers, underscores, dashes, and dots only.
                        </p>
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="wt-form-lbl" for="email">Email</label>
                        <div class="relative flex items-center">
                            <InputText @bind-Value="ModelDTO.Email"
                                       id="email"
                                       class="@GetInputClass(() => ModelDTO.Email)"
                                       placeholder="Email address" />
                            <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">mail</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.Email)" />
                    </div>

                    <!-- Bio -->
                    <div>
                        <label class="wt-form-lbl" for="bio">Bio (Optional)</label>
                        <InputTextArea @bind-Value="ModelDTO.Bio"
                                       id="bio"
                                       class="@GetInputClass(() => ModelDTO.Bio)"
                                       placeholder="Tell us about yourself (max 500 characters)"
                                       rows="3" />
                        <ValidationMessage For="@(() => ModelDTO.Bio)" />
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="wt-form-lbl" for="password">Password</label>
                        <div class="relative flex items-center">
                            <InputText @bind-Value="ModelDTO.Password"
                                       type="password"
                                       id="password"
                                       class="@GetInputClass(() => ModelDTO.Password)"
                                       placeholder="Enter password (min 7 characters)" />
                            <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">lock</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.Password)" />
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="wt-form-lbl" for="confirmPassword">Confirm Password</label>
                        <div class="relative flex items-center">
                            <InputText @bind-Value="ModelDTO.ConfirmPassword"
                                       type="password"
                                       id="confirmPassword"
                                       class="@GetInputClass(() => ModelDTO.ConfirmPassword)"
                                       placeholder="Confirm password" />
                            <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">lock</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.ConfirmPassword)" />
                    </div>

                    <!-- Country Code -->
                    <div>
                        <label class="wt-form-lbl" for="countryCode">Country Code</label>
                        <div class="relative flex items-center">
                            <InputSelect @bind-Value="ModelDTO.CountryCode"
                                         id="countryCode"
                                         class="@(HasValidationErrors(() => ModelDTO.CountryCode) ? "wt-form-input-dd-error" : "wt-form-input-dd")">
                                <option value="">Select Country Code</option>
                                @foreach (var countryCode in countryCodes)
                                {
                                    <option value="@countryCode.Code">@countryCode.Name</option>
                                }
                            </InputSelect>
                            <div class="w-[18px] h-[18px] absolute right-2 pointer-events-none">
                                <span class="material-symbols-rounded text-[18px]">public</span>
                            </div>
                        </div>
                        <ValidationMessage For="@(() => ModelDTO.CountryCode)" />
                    </div>

                    <!-- Accept Terms -->
                    <div class="flex items-start">
                        <div class="flex items-center h-5">
                            <InputCheckbox @bind-Value="ModelDTO.AcceptTerms"
                                           id="acceptTerms"
                                           class="w-4 h-4 border border-harp-400 rounded bg-harp-50 focus:ring-3 focus:ring-harp-300 dark:bg-harp-900 dark:border-harp-600 dark:focus:ring-harp-600 cursor-pointer" />
                        </div>
                        <label for="acceptTerms" class="ml-3 text-sm font-medium text-wt-black-900 dark:text-white cursor-pointer">
                            I accept the <a @onclick="ShowTermsModal" @onclick:preventDefault="true" href="#" class="text-blue-500 hover:underline">Terms and Conditions</a>
                        </label>
                    </div>
                    <ValidationMessage For="@(() => ModelDTO.AcceptTerms)" />
                </div>

                <div class="mt-12">
                    <button type="submit" 
                            class="w-full py-2 px-4 text-[15px] font-medium tracking-wide rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none cursor-pointer" 
                            disabled="@isSubmitting">
                        @(isSubmitting ? "Creating Account..." : "Create Account")
                    </button>
                </div>

                <div class="my-4 flex items-center gap-4">
                    <hr class="w-full border-slate-300 dark:border-slate-600" />
                    <p class="text-sm text-slate-900 dark:text-white text-center">or</p>
                    <hr class="w-full border-slate-300 dark:border-slate-600" />
                </div>

                <button type="button" class="wt-btn-outline-social">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20px" class="inline" viewBox="0 0 512 512">
                        <path fill="#fbbd00"
                              d="M120 256c0-25.367 6.989-49.13 19.131-69.477v-86.308H52.823C18.568 144.703 0 198.922 0 256s18.568 111.297 52.823 155.785h86.308v-86.308C126.989 305.13 120 281.367 120 256z"
                              data-original="#fbbd00" />
                        <path fill="#0f9d58"
                              d="m256 392-60 60 60 60c57.079 0 111.297-18.568 155.785-52.823v-86.216h-86.216C305.044 385.147 281.181 392 256 392z"
                              data-original="#0f9d58" />
                        <path fill="#31aa52"
                              d="m139.131 325.477-86.308 86.308a260.085 260.085 0 0 0 22.158 25.235C123.333 485.371 187.62 512 256 512V392c-49.624 0-93.117-26.72-116.869-66.523z"
                              data-original="#31aa52" />
                        <path fill="#3c79e6"
                              d="M512 256a258.24 258.24 0 0 0-4.192-46.377l-2.251-12.299H256v120h121.452a135.385 135.385 0 0 1-51.884 55.638l86.216 86.216a260.085 260.085 0 0 0 25.235-22.158C485.371 388.667 512 324.38 512 256z"
                              data-original="#3c79e6" />
                        <path fill="#cf2d48"
                              d="m352.167 159.833 10.606 10.606 84.853-84.852-10.606-10.606C388.668 26.629 324.381 0 256 0l-60 60 60 60c36.326 0 70.479 14.146 96.167 39.833z"
                              data-original="#cf2d48" />
                        <path fill="#eb4132"
                              d="M256 120V0C187.62 0 123.333 26.629 74.98 74.98a259.849 259.849 0 0 0-22.158 25.235l86.308 86.308C162.883 146.72 206.376 120 256 120z"
                              data-original="#eb4132" />
                    </svg>
                    Continue with Google
                </button>

                <button type="button" class="wt-btn-outline-social">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20px" fill="#000" viewBox="0 0 22.773 22.773">
                        <path d="M15.769 0h.162c.13 1.606-.483 2.806-1.228 3.675-.731.863-1.732 1.7-3.351 1.573-.108-1.583.506-2.694 1.25-3.561C13.292.879 14.557.16 15.769 0zm4.901 16.716v.045c-.455 1.378-1.104 2.559-1.896 3.655-.723.995-1.609 2.334-3.191 2.334-1.367 0-2.275-.879-3.676-.903-1.482-.024-2.297.735-3.652.926h-.462c-.995-.144-1.798-.932-2.383-1.642-1.725-2.098-3.058-4.808-3.306-8.276v-1.019c.105-2.482 1.311-4.5 2.914-5.478.846-.52 2.009-.963 3.304-.765.555.086 1.122.276 1.619.464.471.181 1.06.502 1.618.485.378-.011.754-.208 1.135-.347 1.116-.403 2.21-.865 3.652-.648 1.733.262 2.963 1.032 3.723 2.22-1.466.933-2.625 2.339-2.427 4.74.176 2.181 1.444 3.457 3.028 4.209z" data-original="#000000"></path>
                    </svg>
                    Continue with Apple
                </button>

                <button type="button" class="wt-btn-outline-social">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20px" fill="#007bff" viewBox="0 0 167.657 167.657">
                        <path d="M83.829.349C37.532.349 0 37.881 0 84.178c0 41.523 30.222 75.911 69.848 82.57v-65.081H49.626v-23.42h20.222V60.978c0-20.037 12.238-30.956 30.115-30.956 8.562 0 15.92.638 18.056.919v20.944l-12.399.006c-9.72 0-11.594 4.618-11.594 11.397v14.947h23.193l-3.025 23.42H94.026v65.653c41.476-5.048 73.631-40.312 73.631-83.154 0-46.273-37.532-83.805-83.828-83.805z" data-original="#010002"></path>
                    </svg>
                    Continue with Facebook
                </button>
            </EditForm>
        </div>
    </div>
</div>
                    

