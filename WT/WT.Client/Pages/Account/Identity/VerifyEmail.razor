@page "/account/identity/verify-email"
@using Microsoft.AspNetCore.Components.Authorization
@inject IAccountService AccountService
@inject NavigationManager NavigationManager

<PageTitle>WheelyTrails - Verify Email</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private VerifyEmailDTO ModelDTO { get; set; } = new();
    private bool isVerifying = false;
    private string? errorMessage;
    private string? successMessage;
    private VerificationState currentState = VerificationState.Loading;

    private enum VerificationState
    {
        Loading,
        Success,
        Error,
        MissingToken
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"Verify Email page initialized. Token present: {!string.IsNullOrEmpty(Token)}");

        if (string.IsNullOrEmpty(Token))
        {
            currentState = VerificationState.MissingToken;
            errorMessage = "Verification token is missing from the URL.";
            Console.WriteLine("❌ No verification token provided");
            return;
        }

        ModelDTO.Token = Uri.UnescapeDataString(Token);
        await VerifyEmailAsync();
    }

    private async Task VerifyEmailAsync()
    {
        if (string.IsNullOrEmpty(ModelDTO.Token))
        {
            currentState = VerificationState.Error;
            errorMessage = "Verification token is required.";
            return;
        }

        try
        {
            isVerifying = true;
            currentState = VerificationState.Loading;
            StateHasChanged();

            Console.WriteLine($"🔍 Attempting to verify email with token length: {ModelDTO.Token.Length}");

            var response = await AccountService.VerifyEmailAsync(ModelDTO.Token);

            Console.WriteLine($"Response received. Success: {response.Success}");

            if (response.Success)
            {
                currentState = VerificationState.Success;
                successMessage = response.Message;
                // short delay then navigate (keeps behaviour)
                await Task.Delay(3000);
                NavigationManager.NavigateTo("/account/identity/login", forceLoad: false);
            }
            else
            {
                currentState = VerificationState.Error;
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception during verification: {ex.Message}");
            currentState = VerificationState.Error;
            errorMessage = "An unexpected error occurred during verification. Please try again or contact support.";
        }
        finally
        {
            isVerifying = false;
            StateHasChanged();
        }
    }

    private void NavigateToLogin() => NavigationManager.NavigateTo("/account/identity/login", forceLoad: false);
    private void NavigateToRegister() => NavigationManager.NavigateTo("/account/identity/register", forceLoad: false);
    private void NavigateToHome() => NavigationManager.NavigateTo("/", forceLoad: false);
}

<div class="min-h-screen pt-16 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">

            <!-- Illustration / desktop only -->
            <div class="hidden md:block rounded-xl overflow-hidden shadow-elevation-2">
                <img src="https://readymadeui.com/image-3.webp"
                     alt="Verify email illustration"
                     class="w-full h-[520px] object-cover bg-[var(--md-sys-color-surface-container-lowest)]" />
            </div>

            <!-- Card -->
            <div class="w-full max-w-xl mx-auto">
                <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)] rounded-xl shadow-elevation-2 p-8">
                    @if (currentState == VerificationState.Loading)
                    {
                        <div class="text-center space-y-6">
                            <div class="inline-flex items-center justify-center w-20 h-20 bg-[var(--md-sys-color-surface-container-high)] rounded-full mb-4">
                                <svg class="animate-spin h-10 w-10 text-[var(--md-sys-color-primary)]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                            </div>

                            <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Verifying Email</h1>
                            <p class="text-[var(--md-sys-color-on-surface-variant)]">
                                Please wait while we verify your email address...
                            </p>
                        </div>
                    }
                    else if (currentState == VerificationState.Success)
                    {
                        <div class="text-center space-y-6">
                            <div class="inline-flex items-center justify-center w-24 h-24 bg-[var(--md-sys-color-primary-container)] rounded-full mb-4">
                                <span class="material-symbols-rounded text-4xl text-[var(--md-sys-color-on-primary-container)]">check_circle</span>
                            </div>

                            <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Email Verified</h1>

                            <div class="p-4 bg-[var(--md-sys-color-primary-container)] rounded-md">
                                <p class="text-[var(--md-sys-color-on-primary-container)]">@(!string.IsNullOrEmpty(successMessage) ? successMessage : "Your email has been successfully verified.")</p>
                            </div>

                            <p class="text-[var(--md-sys-color-on-surface-variant)]">You'll be redirected to the login page shortly.</p>

                            <div class="mt-4 flex flex-col sm:flex-row gap-3 justify-center">
                                <button @onclick="NavigateToLogin"
                                        class="px-6 py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)] shadow-elevation-2 hover:shadow-elevation-3 focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]">
                                    Continue to Login
                                </button>
                                <button @onclick="NavigateToHome"
                                        class="px-6 py-3 rounded-full bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] border border-[var(--md-sys-color-outline-variant)]">
                                    Return to Home
                                </button>
                            </div>
                        </div>
                    }
                    else if (currentState == VerificationState.Error)
                    {
                        <div class="text-center space-y-6">
                            <div class="inline-flex items-center justify-center w-24 h-24 bg-[var(--md-sys-color-error-container)] rounded-full mb-4">
                                <span class="material-symbols-rounded text-4xl text-[var(--md-sys-color-on-error-container)]">error</span>
                            </div>

                            <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Verification Failed</h1>

                            <div class="p-4 bg-[var(--md-sys-color-error-container)] rounded-md">
                                <p class="text-[var(--md-sys-color-on-error-container)]">@(!string.IsNullOrEmpty(errorMessage) ? errorMessage : "The verification link is invalid or has expired.")</p>
                            </div>

                            <div class="mt-4 space-y-3">
                                <button @onclick="NavigateToLogin" class="w-full py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)]">Try Logging In</button>
                                <button @onclick="NavigateToRegister" class="w-full py-3 rounded-full bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] border border-[var(--md-sys-color-outline-variant)]">Register New Account</button>
                                <button @onclick="NavigateToHome" class="w-full py-3 rounded-full bg-transparent text-[var(--md-sys-color-on-surface)]">Back to Home</button>
                            </div>
                        </div>
                    }
                    else if (currentState == VerificationState.MissingToken)
                    {
                        <div class="text-center space-y-6">
                            <div class="inline-flex items-center justify-center w-24 h-24 bg-[var(--md-sys-color-surface-container-high)] rounded-full mb-4">
                                <span class="material-symbols-rounded text-4xl text-[var(--md-sys-color-primary)]">warning</span>
                            </div>

                            <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Invalid Verification Link</h1>

                            <div class="p-4 bg-[var(--md-sys-color-surface)] rounded-md">
                                <p class="text-[var(--md-sys-color-on-surface-variant)]">This page requires a verification token from your registration email.</p>
                            </div>

                            <div class="mt-4 space-y-3">
                                <button @onclick="NavigateToRegister" class="w-full py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)]">Register New Account</button>
                                <button @onclick="NavigateToLogin" class="w-full py-3 rounded-full bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] border border-[var(--md-sys-color-outline-variant)]">Already Verified? Sign In</button>
                                <button @onclick="NavigateToHome" class="w-full py-3 rounded-full bg-transparent text-[var(--md-sys-color-on-surface)]">Back to Home</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>