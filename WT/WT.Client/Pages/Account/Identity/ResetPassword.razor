@page "/account/identity/reset-password"
@using System.Linq.Expressions
@inject IAccountService AccountService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>WheelyTrails - Reset Password</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private ResetPasswordDTO ModelDTO { get; set; } = new();
    private EditContext? editcontext;

    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private bool showPassword = false;
    private bool showConfirmPassword = false;

    // Password strength indicator
    private int passwordScore = 0;
    private string passwordStrengthLabel = "Too short";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            ModelDTO.Email = Uri.UnescapeDataString(Email);
        }

        if (!string.IsNullOrEmpty(Token))
        {
            ModelDTO.Token = Uri.UnescapeDataString(Token);
        }

        editcontext = new EditContext(ModelDTO);
        Console.WriteLine($"Reset Password page initialized. Token present: {!string.IsNullOrEmpty(Token)}, Email: {Email}");
    }

    private async Task HandleValidSubmit()
    {
        if (isSubmitting) return;

        if (string.IsNullOrEmpty(ModelDTO.Token))
        {
            errorMessage = "Reset token is missing. Please use the link from your email.";
            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var response = await AccountService.ResetPasswordAsync(ModelDTO);

            if (response.Success)
            {
                successMessage = response.Message;
                ModelDTO.NewPassword = string.Empty;
                ModelDTO.ConfirmPassword = string.Empty;
                UpdatePasswordStrength(string.Empty);
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception: {ex.Message}");
            errorMessage = "An unexpected error occurred. Please try again later.";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ToggleConfirmPasswordVisibility() => showConfirmPassword = !showConfirmPassword;

    private bool HasValidationErrors(Expression<Func<string?>> accessor)
    {
        if (editcontext == null) return false;
        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editcontext.GetValidationMessages(fieldIdentifier).Any();
    }

    private string GetInputClass(Expression<Func<string?>> accessor)
    {
        return HasValidationErrors(accessor) ? "wt-form-input-error" : "wt-form-input";
    }

    private void UpdatePasswordStrength(string? pwd)
    {
        passwordScore = CalculatePasswordScore(pwd);
        passwordStrengthLabel = passwordScore switch
        {
            0 => "Too short",
            1 => "Weak",
            2 => "Fair",
            3 => "Good",
            4 => "Strong",
            _ => "Too short"
        };
        StateHasChanged();
    }

    private int CalculatePasswordScore(string? pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        var score = 0;

        if (pwd.Length >= 7) score++;
        if (pwd.Any(char.IsLower)) score++;
        if (pwd.Any(char.IsUpper)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(ch => !char.IsLetterOrDigit(ch))) score++;

        return Math.Min(score, 4);
    }

    // Explicit input handler for the new password raw <input>.
    // Writes directly to ModelDTO.NewPassword and updates the strength UI.
    private Task OnNewPasswordInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? string.Empty;
        ModelDTO.NewPassword = v;
        UpdatePasswordStrength(v);
        return Task.CompletedTask;
    }

    // Added invalid-submit handler to avoid passing literal null
    private void HandleInvalidSubmit()
    {
        Console.WriteLine("HandleInvalidSubmit called - form invalid");

        if (editcontext != null)
        {
            var errors = editcontext.GetValidationMessages();
            foreach (var error in errors)
            {
                Console.WriteLine($"  - {error}");
            }
        }
    }

    private void NavigateToLogin() => NavigationManager.NavigateTo("/account/identity/login", forceLoad: false);
}

<div class="min-h-screen pt-16 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">

            <!-- Illustration / desktop only -->
            <div class="hidden md:block rounded-xl overflow-hidden shadow-elevation-2">
                <img src="https://readymadeui.com/image-3.webp"
                     alt="Reset password illustration"
                     class="w-full h-[520px] object-cover bg-[var(--md-sys-color-surface-container-lowest)]" />
            </div>

            <!-- Form Card -->
            <div class="w-full max-w-xl mx-auto">
                <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)] rounded-xl shadow-elevation-2 p-8">
                    @if (string.IsNullOrEmpty(ModelDTO.Token))
                    {
                        <div class="text-center space-y-6">
                            <div class="inline-flex items-center justify-center w-20 h-20 bg-[var(--md-sys-color-error-container)] rounded-full mb-4">
                                <span class="material-symbols-rounded text-3xl text-[var(--md-sys-color-on-error-container)]">error</span>
                            </div>

                            <h2 class="text-2xl font-semibold text-[var(--md-sys-color-on-surface)]">Invalid Reset Link</h2>
                            <p class="text-[var(--md-sys-color-on-surface-variant)]">This password reset link is invalid or has expired. Please request a new password reset.</p>

                            <div class="mt-4 space-y-3">
                                <a href="/account/identity/forgot-password" class="w-full inline-flex justify-center px-6 py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)]">Request New Reset Link</a>
                                <a href="/account/identity/login" class="w-full inline-flex justify-center px-6 py-3 rounded-full bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] border border-[var(--md-sys-color-outline-variant)]">Back to Login</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Note: OnInvalidSubmit no longer set to null -->
                        <EditForm EditContext="editcontext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                            <DataAnnotationsValidator />

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-error-container)] text-[var(--md-sys-color-on-error-container)]">
                                    @errorMessage
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <div class="mb-4 p-3 rounded-md bg-[var(--md-sys-color-primary-container)] text-[var(--md-sys-color-on-primary-container)]">
                                    @successMessage
                                </div>
                            }

                            <div class="mb-6">
                                <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)]">Reset Password</h1>
                                <p class="text-[var(--md-sys-color-on-surface-variant)] mt-2">Enter your new password below.</p>
                            </div>

                            <div class="space-y-6">
                                <div>
                                    <label class="wt-form-lbl" for="email">Email</label>
                                    <div class="relative flex items-center">
                                        <InputText @bind-Value="ModelDTO.Email"
                                                   id="email"
                                                   readonly
                                                   class="wt-form-input bg-slate-100 dark:bg-harp-800 cursor-not-allowed"
                                                   placeholder="Email address" />
                                    </div>
                                    <ValidationMessage For="@(() => ModelDTO.Email)" class="wt-form-error-msg" />
                                </div>

                                <InputText @bind-Value="ModelDTO.Token" type="hidden" />

                                <div>
                                    <label class="wt-form-lbl" for="newPassword">New Password</label>
                                    <div class="relative">
                                        <!-- raw input keeps Blazor from re-mounting an InputText and clearing value -->
                                        <input id="newPassword"
                                               type="@(showPassword ? "text" : "password")"
                                               value="@ModelDTO.NewPassword"
                                               @oninput="OnNewPasswordInput"
                                               class="@GetInputClass(() => ModelDTO.NewPassword) w-full pr-10"
                                               placeholder="Enter new password (min 7 characters)" />

                                        <button type="button"
                                                @onclick="TogglePasswordVisibility"
                                                class="absolute inset-y-0 right-0 pr-2 flex items-center text-[var(--md-sys-color-on-surface-variant)]
                                                       bg-transparent rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                                aria-label="Toggle new password visibility">
                                            <span class="material-symbols-rounded text-[18px]">@(showPassword ? "visibility_off" : "visibility")</span>
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => ModelDTO.NewPassword)" class="wt-form-error-msg" />

                                    <!-- Password strength indicator -->
                                    <div class="mt-2">
                                        <div class="h-2 w-full rounded-full bg-[var(--md-sys-color-surface-container-high)] overflow-hidden">
                                            <div style="width:@(passwordScore * 25)%; background-color:@GetStrengthColor(passwordScore); height:100%; transition:width .18s ease-in-out;"></div>
                                        </div>
                                        <p class="text-xs mt-1 text-[var(--md-sys-color-on-surface-variant)]">@passwordStrengthLabel</p>
                                    </div>
                                </div>

                                <div>
                                    <label class="wt-form-lbl" for="confirmPassword">Confirm New Password</label>
                                    <div class="relative">
                                        <InputText @bind-Value="ModelDTO.ConfirmPassword"
                                                   type="@(showConfirmPassword ? "text" : "password")"
                                                   id="confirmPassword"
                                                   class="@GetInputClass(() => ModelDTO.ConfirmPassword)"
                                                   placeholder="Confirm new password" />
                                        <button type="button" @onclick="ToggleConfirmPasswordVisibility"
                                                class="absolute inset-y-0 right-0 pr-2 flex items-center text-[var(--md-sys-color-on-surface-variant)] focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]"
                                                aria-label="Toggle confirm password visibility">
                                            <span class="material-symbols-rounded text-[18px]">@(showConfirmPassword ? "visibility_off" : "visibility")</span>
                                        </button>
                                    </div>
                                    <ValidationMessage For="@(() => ModelDTO.ConfirmPassword)" class="wt-form-error-msg" />

                                    @if (!string.IsNullOrEmpty(ModelDTO.NewPassword) && !string.IsNullOrEmpty(ModelDTO.ConfirmPassword))
                                    {
                                        <div class="mt-2 text-xs">
                                            @if (ModelDTO.NewPassword == ModelDTO.ConfirmPassword)
                                            {
                                                <span class="text-green-600 dark:text-green-400 flex items-center"><span class="material-symbols-rounded mr-1 text-[14px]">check_circle</span>Passwords match</span>
                                            }
                                            else
                                            {
                                                <span class="text-red-600 dark:text-red-400 flex items-center"><span class="material-symbols-rounded mr-1 text-[14px]">cancel</span>Passwords do not match</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="p-4 bg-[var(--md-sys-color-surface-container-high)] rounded-lg text-sm">
                                    <p class="font-semibold mb-1">Password Requirements:</p>
                                    <ul class="list-disc ml-5 space-y-1">
                                        <li>At least 7 characters long</li>
                                        <li>Use a mix of letters, numbers, and symbols for better security</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="mt-8">
                                <button type="submit"
                                        class="w-full py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)] shadow-elevation-2 hover:shadow-elevation-3"
                                        disabled="@isSubmitting">
                                    @(isSubmitting ? "Resetting Password..." : "Reset Password")
                                </button>
                            </div>

                            <div class="mt-4 text-center">
                                <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">Remember your password? <a href="/account/identity/login" class="wt-link">Sign in here</a></p>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStrengthColor(int score)
    {
        return score switch
        {
            0 or 1 => "var(--md-sys-color-error)",
            2 => "var(--md-sys-color-tertiary)",
            3 => "var(--md-sys-color-secondary)",
            4 => "var(--md-sys-color-primary)",
            _ => "var(--md-sys-color-outline)"
        };
    }
}
