@page "/account/identity/registration-success"
@inject NavigationManager NavigationManager
@inject IAccountService AccountService

<PageTitle>Registration Successful - WheelyTrails</PageTitle>

@code {
    // Capture email from query parameter
    [Parameter]
    [SupplyParameterFromQuery(Name = "email")]
    public string? userEmail { get; set; }

    private bool isResending = false;
    private string? resendMessage;
    private bool resendSuccess = false;

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/account/identity/login", forceLoad: false);
    }

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("/", forceLoad: false);
    }

    private async Task ResendVerificationEmail()
    {
        if (isResending) return;

        if (string.IsNullOrEmpty(userEmail))
        {
            resendSuccess = false;
            resendMessage = "Email address not found. Please register again.";
            StateHasChanged();
            return;
        }

        try
        {
            isResending = true;
            resendMessage = null;
            StateHasChanged();

            // TODO: Replace with real API call when available
            // var response = await AccountService.ResendVerificationEmailAsync(userEmail);
            await Task.Delay(1000);

            resendSuccess = true;
            resendMessage = $"Verification email resent to {userEmail}. Please check your inbox.";
        }
        catch (Exception ex)
        {
            resendSuccess = false;
            resendMessage = "Failed to resend verification email. Please try again later.";
            Console.WriteLine($"ResendVerificationEmail error: {ex}");
        }
        finally
        {
            isResending = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        Console.WriteLine($"Registration success page loaded for email: {userEmail ?? "Unknown"}");
    }
}

<!-- Page layout: match Design-Notes.md and Register/Login pages -->
<div class="min-h-screen pt-16 bg-[var(--md-sys-color-background)] text-[var(--md-sys-color-on-background)]">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-2 gap-8 items-center">

            <!-- Illustration (desktop only) -->
            <div class="hidden md:block rounded-xl overflow-hidden shadow-elevation-2">
                <img src="https://readymadeui.com/image-3.webp"
                     alt="Welcome to WheelyTrails"
                     class="w-full h-[520px] object-cover bg-[var(--md-sys-color-surface-container-lowest)]" />
            </div>

            <!-- Content Card -->
            <div class="w-full max-w-2xl mx-auto">
                <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface)]
                            rounded-xl shadow-elevation-2 p-8 space-y-6">
                    <div class="text-center">
                        <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-[var(--md-sys-color-primary-container)] mb-4">
                            <span class="material-symbols-rounded text-4xl text-[var(--md-sys-color-on-primary-container)]">
                                check_circle
                            </span>
                        </div>

                        <h1 class="text-3xl font-semibold text-[var(--md-sys-color-on-surface)] mb-2">
                            Registration successful!
                        </h1>

                        <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">
                            Welcome to WheelyTrails — we're excited to have you.
                        </p>
                    </div>

                    <!-- Verification instructions -->
                    <div class="bg-[var(--md-sys-color-surface)] dark:bg-[var(--md-sys-color-surface-container-high)]
                                rounded-lg p-6 space-y-4 border border-[var(--md-sys-color-outline-variant)]">
                        <div class="flex items-start gap-4">
                            <div class="flex-shrink-0">
                                <span class="material-symbols-rounded text-2xl text-[var(--md-sys-color-primary)]">
                                    mail
                                </span>
                            </div>

                            <div class="flex-1">
                                <h2 class="text-lg font-medium text-[var(--md-sys-color-on-surface)] mb-1">Check your email</h2>

                                @if (!string.IsNullOrEmpty(userEmail))
                                {
                                    <p class="text-[var(--md-sys-color-on-surface-variant)] mb-2">
                                        We've sent a verification email to:
                                    </p>

                                    <div class="bg-[var(--md-sys-color-surface-container-lowest)] dark:bg-[var(--md-sys-color-surface-container-high)]
                                                rounded-md p-3 mb-2">
                                        <p class="text-base font-semibold text-[var(--md-sys-color-on-surface)] break-all">
                                            @userEmail
                                        </p>
                                    </div>

                                    <p class="text-[var(--md-sys-color-on-surface-variant)]">
                                        Please open that email and click the verification link to activate your account.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-[var(--md-sys-color-on-surface-variant)]">
                                        Please check your inbox for a verification link and follow the instructions to activate your account.
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="border-t border-[var(--md-sys-color-outline-variant)] pt-4">
                            <h3 class="text-sm font-medium text-[var(--md-sys-color-on-surface)] mb-2">Next steps</h3>
                            <ol class="list-none space-y-2 text-[var(--md-sys-color-on-surface-variant)]">
                                <li class="flex items-start gap-3">
                                    <span class="material-symbols-rounded text-[var(--md-sys-color-on-surface-variant)] mt-0.5">arrow_forward</span>
                                    <span>Open your email inbox (check spam/junk if you can't find it).</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="material-symbols-rounded text-[var(--md-sys-color-on-surface-variant)] mt-0.5">arrow_forward</span>
                                    <span>Find the message from WheelyTrails and click the verification link.</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    <span class="material-symbols-rounded text-[var(--md-sys-color-on-surface-variant)] mt-0.5">arrow_forward</span>
                                    <span>After verification you can sign in and start exploring trails.</span>
                                </li>
                            </ol>
                        </div>
                    </div>

                    <!-- Call to action buttons -->
                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <button @onclick="NavigateToLogin"
                                class="w-full sm:w-auto px-6 py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)]
                                       shadow-elevation-2 hover:shadow-elevation-3 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]">
                            Go to Login
                        </button>

                        <button @onclick="NavigateToHome"
                                class="w-full sm:w-auto px-6 py-3 rounded-full bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)]
                                       border border-[var(--md-sys-color-outline-variant)] hover:border-[var(--md-sys-color-outline)] shadow transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--md-sys-color-primary)]">
                            Return to Home
                        </button>
                    </div>

                    <!-- Help & resend -->
                    <div class="text-center pt-4 border-t border-[var(--md-sys-color-outline-variant)]">
                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">
                                Didn't receive the email at <strong class="text-[var(--md-sys-color-on-surface)]">@userEmail</strong>?
                                <br />
                                Check your spam folder or
                                <button @onclick="ResendVerificationEmail"
                                        class="ml-1 text-[var(--md-sys-color-primary)] hover:underline font-medium"
                                        disabled="@isResending"
                                        aria-label="Resend verification email">
                                    @(isResending ? "Sending..." : "resend verification email")
                                </button>
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">
                                Didn't receive the verification email?
                                <button @onclick="ResendVerificationEmail"
                                        class="ml-1 text-[var(--md-sys-color-primary)] hover:underline font-medium"
                                        disabled="@isResending"
                                        aria-label="Resend verification email">
                                    @(isResending ? "Sending..." : "resend verification email")
                                </button>
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(resendMessage))
                        {
                            <p class="mt-3 text-sm @(resendSuccess ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                @resendMessage
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

