@page "/user/{profileUsername}"

@using WT.Application.DTO.Response
@using WT.Application.Extensions

@inject NavigationManager NavigationManager
@inject IAccountService AccountService

<PageTitle>WheelyTrails - @PageTitle</PageTitle>

@code {
    [Parameter]
    public string profileUsername { get; set; } = string.Empty;

    private APIResponsePublicViewProfile? Profile;
    private bool isLoading = true;
    private string? errorMessage;
    private CancellationTokenSource? cts;
    private string PageTitle { get; set; } = "View Profile";

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        errorMessage = null;

        cts?.Cancel();
        cts = new CancellationTokenSource();
        var token = cts.Token;
        string generalErrorMessage = "An unexpected error occurred while loading the profile.";

        try
        {
            if (string.IsNullOrWhiteSpace(profileUsername))
            {
                errorMessage = "No profile specified.";
                return;
            }

            // Use AccountService to fetch public profile; service should accept a cancellation token
            Profile = await AccountService.ViewProfileByUsernameAsync(profileUsername, token);

            if (Profile == null)
            {
                // If's null, we have an unexpected error, redirect to Error page with
                // friendly message
                NavigationManager.NavigateTo($"/error/{generalErrorMessage}", forceLoad: false);
            }

            // Example of handling failure codes404,
            if (Profile != null)
            {
                if (Profile.FailuerCode.HasValue)
                {
                    if (Profile.FailuerCode == 404)
                    {
                        errorMessage = "Profile not found.";
                        // navigate to not found page
                        NavigationManager.NavigateTo("/notfound");
                    }
                    else
                    {
                        // Navigate to general error page
                        NavigationManager.NavigateTo($"/error/{generalErrorMessage}", forceLoad: false);
                    }
                }
            }

            // Set page title
            if (Profile != null)
            {
                if (Profile.PublicProfile != null)
                {
                    PageTitle = $"View @{Profile.PublicProfile.ProfileUsername} on WheelyTrails";
                }
            }
        }
        catch (OperationCanceledException)
        {
            // ignore cancellation
        }
        catch (Exception ex)
        {
            // We reall don't have to worry about logging this exception here,
            // as it should be logged in the service layer already. Just redirect
            // user to error page with friendly message.
            NavigationManager.NavigateTo($"/error/{generalErrorMessage}", forceLoad: false);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}


<!-- Page background follows Material3 tokens from Design-Notes.md -->
<div class="min-h-screen bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] flex items-start justify-center py-8">
    <div class="w-full max-w-6xl px-4 sm:px-6 lg:px-8 p-6">
        @if (isLoading)
        {
            <div class="flex items-center justify-center h-48">
                <div class="animate-pulse flex items-center space-x-4">
                    <div class="rounded-full bg-slate-200 dark:bg-slate-700 h-24 w-24"></div>
                    <div class="flex-1 space-y-2 py-1">
                        <div class="h-4 bg-slate-200 dark:bg-slate-700 rounded w-3/4"></div>
                        <div class="h-3 bg-slate-200 dark:bg-slate-700 rounded w-1/2"></div>
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-[var(--md-sys-color-error-container)] dark:bg-[var(--md-sys-color-error-container)] text-[var(--md-sys-color-on-error-container)] p-4 rounded">
                @errorMessage
            </div>
        }
        else if (Profile is not null)
        {
            <!-- Use surface-container-high for the profile card to match MD3 guidance -->
            <div class="bg-[var(--md-sys-color-surface-container-high)] dark:bg-[var(--md-sys-color-surface-container-high)] rounded-2xl shadow-elevation-3 p-6">
                <!-- Responsive grid: avatar + basic info on the left, stats & about on the right for larger screens -->
                <div class="grid gap-6 md:grid-cols-3 items-start">
                    <div class="flex flex-col items-center text-center md:items-start md:text-left">
                        <div class="relative">
                            @if (!string.IsNullOrEmpty(Profile.PublicProfile.ProfilePicture))
                            {
                                <img src="@Profile.PublicProfile.ProfilePicture" alt="Profile" class="h-28 w-28 md:h-36 md:w-36 rounded-full object-cover ring-4 ring-white dark:ring-slate-900 shadow-sm" />
                            }
                            else
                            {
                                <div class="h-28 w-28 md:h-36 md:w-36 rounded-full bg-[var(--md-sys-color-surface)] dark:bg-[var(--md-sys-color-surface)] flex items-center justify-center text-[var(--md-sys-color-on-surface-variant)] ring-4 ring-white dark:ring-slate-900"
                                    id="viewprofile-noimage-wrap">
                                    <!-- Make the material icon scale to fit the parent circle. Use explicit font-size and remove extra line-height. -->
                                    <span class="material-symbols-rounded leading-none text-[4.5rem] md:text-[5rem]">
                                        account_circle
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="mt-4">
                            @{
                                var profileUsernameFormat = $"@{Profile.PublicProfile.ProfileUsername}";
                            }
                            <div class="text-base md:text-lg font-semibold text-[var(--md-sys-color-on-surface)] dark:text-[var(--md-sys-color-on-surface)]">@Profile.PublicProfile.FirstName</div>
                            <div class="text-xl md:text-2xl font-semibold text-[var(--md-sys-color-on-surface)] dark:text-[var(--md-sys-color-on-surface)]">@profileUsernameFormat</div>
                            <div class="mt-1 text-sm md:text-base text-[var(--md-sys-color-on-surface-variant)] dark:text-[var(--md-sys-color-on-surface-variant)] flex items-center justify-center md:justify-start gap-2">
                                <span class="material-symbols-rounded text-[var(--md-sys-color-on-surface-variant)]">
                                    location_on
                                </span>
                                <span>@(string.IsNullOrWhiteSpace(Profile.PublicProfile.CountryCode) ? "" : StringHelpers.GetCountryName(Profile.PublicProfile.CountryCode))</span>
                                <span class="mx-2">•</span>
                                <span>Member since @Profile.PublicProfile.MemberSince?.ToString("yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="md:col-span-2 flex flex-col">
                        <div class="mt-0 w-full grid grid-cols-3 gap-3">
                            <!-- Add elevation and use surface-container for stat cards -->
                            <div class="bg-[var(--md-sys-color-surface-container)] dark:bg-[var(--md-sys-color-surface-container)] p-3 rounded-lg text-center shadow-elevation-2 border border-[var(--md-sys-color-outline-variant)] transform hover:-translate-y-0.5 hover:shadow-elevation-4 transition-transform duration-150 cursor-pointer">
                                <div class="text-lg md:text-xl font-bold text-[var(--md-sys-color-on-surface)]">@((Profile.PublicProfile.TrailsCount ?? 0))</div>
                                <div class="text-xs md:text-sm text-[var(--md-sys-color-on-surface-variant)]">Trails</div>
                            </div>
                            <div class="bg-[var(--md-sys-color-surface-container)] dark:bg-[var(--md-sys-color-surface-container)] p-3 rounded-lg text-center shadow-elevation-2 border border-[var(--md-sys-color-outline-variant)] transform hover:-translate-y-0.5 hover:shadow-elevation-4 transition-transform duration-150 cursor-pointer">
                                <div class="text-lg md:text-xl font-bold text-[var(--md-sys-color-on-surface)]">@((Profile.PublicProfile.CommentsCount ?? 0))</div>
                                <div class="text-xs md:text-sm text-[var(--md-sys-color-on-surface-variant)]">Following</div>
                            </div>
                            <div class="bg-[var(--md-sys-color-surface-container)] dark:bg-[var(--md-sys-color-surface-container)] p-3 rounded-lg text-center shadow-elevation-2 border border-[var(--md-sys-color-outline-variant)] transform hover:-translate-y-0.5 hover:shadow-elevation-4 transition-transform duration-150 cursor-pointer">
                                <div class="text-lg md:text-xl font-bold text-[var(--md-sys-color-on-surface)]">@((Profile.PublicProfile.LikesCount ?? 0))</div>
                                <div class="text-xs md:text-sm text-[var(--md-sys-color-on-surface-variant)]">Followers</div>
                            </div>
                        </div>

                        <div class="mt-6 w-full">
                            <div class="bg-[var(--md-sys-color-surface-container)] dark:bg-[var(--md-sys-color-surface-container)] p-4 rounded-lg shadow-elevation-1 border border-[var(--md-sys-color-outline-variant)]">
                                <div class="text-sm md:text-base font-semibold text-[var(--md-sys-color-on-surface)] mb-2">About Me</div>
                                <div class="text-sm md:text-base text-[var(--md-sys-color-on-surface-variant)]">@(!string.IsNullOrWhiteSpace(Profile.PublicProfile.Bio) ? Profile.PublicProfile.Bio : "This user hasn't added an about section yet.")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>