@page "/notfound"
@inject NavigationManager Navigation

<PageTitle>Page Not Found - WheelyTrails</PageTitle>

<!-- Material3 styled404 page following Design-Notes.md tokens and Tailwind utilities -->
<section class="min-h-screen flex items-center justify-center bg-[var(--md-sys-color-surface)] text-[var(--md-sys-color-on-surface)] py-20">
    <div class="w-full max-w-3xl px-6">
         <div class="bg-[var(--md-sys-color-surface-container-high)] dark:bg-[var(--md-sys-color-surface-container-high)] rounded-xl shadow-elevation-3 border border-[var(--md-sys-color-outline-variant)] overflow-hidden">
             <div class="p-10 text-center">

                 <!--404 Number -->
                 <div class="mb-6">
                    <h1 class="text-[140px] md:text-[180px] lg:text-[220px] leading-none font-extrabold text-[var(--md-sys-color-on-surface-variant)] select-none">404</h1>
                 </div>

                 <!-- Icon and Heading -->
                 <div class="mb-6">
                     <div class="inline-flex items-center justify-center w-20 h-20 mb-4 rounded-full bg-[var(--md-sys-color-primary-container)]">
                        <span class="material-symbols-rounded text-[36px] text-[var(--md-sys-color-on-primary-container)]">directions_walk</span>
                     </div>

                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[var(--md-sys-color-on-surface)] mb-3">Page Not Found</h2>

                    <p class="text-base md:text-lg text-[var(--md-sys-color-on-surface-variant)] max-w-2xl mx-auto">Sorry — the page you’re looking for can’t be found. It may have been removed, had its name changed, or is temporarily unavailable.</p>
                </div>

                 <!-- Action Buttons -->
                 <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mt-6 mb-6">
                     <button @onclick="NavigateHome" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[var(--md-sys-color-primary)] text-[var(--md-sys-color-on-primary)] font-semibold shadow-elevation-2 hover:shadow-elevation-4 transition-shadow duration-150 min-w-[160px] justify-center">
                     <span class="material-symbols-rounded">home</span>
                     Back to Home
                     </button>

                     <button @onclick="NavigateToTrails" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[var(--md-sys-color-outline)] bg-[color:var(--md-sys-color-surface)/0.8] text-[var(--md-sys-color-primary)] font-semibold hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors duration-150 min-w-[160px] justify-center">
                     <span class="material-symbols-rounded">map</span>
                     Browse Trails
                     </button>
                 </div>

                 <hr class="my-4 border-[var(--md-sys-color-outline-variant)]" />

                 <!-- Helpful Links -->
                 <div class="pt-4">
                     <p class="text-sm text-[var(--md-sys-color-on-surface-variant)] mb-3">You might be looking for:</p>
                     <div class="flex flex-wrap justify-center gap-4">
                     <a href="/" class="text-[var(--md-sys-color-primary)] hover:underline">Home</a>
                     <a href="/trails" class="text-[var(--md-sys-color-primary)] hover:underline">Trails</a>
                     <a href="/trails/discover" class="text-[var(--md-sys-color-primary)] hover:underline">Discover</a>
                     <a href="/account/identity/login" class="text-[var(--md-sys-color-primary)] hover:underline">Login</a>
                     <a href="/account/identity/register" class="text-[var(--md-sys-color-primary)] hover:underline">Sign Up</a>
                     <a href="/contact" class="text-[var(--md-sys-color-primary)] hover:underline">Contact Us</a>
                     </div>
                 </div>
                 </div>
         </div>
     </div>
</section>

@code {
 private void NavigateHome()
 {
    Navigation.NavigateTo("/", forceLoad: false);
 }

 private void NavigateToTrails()
 {
    Navigation.NavigateTo("/trails", forceLoad: false);
 }

 protected override void OnInitialized()
 {
     // Log404 event for diagnostics
     Console.WriteLine($"404 Error: User navigated to non-existent page at {DateTime.UtcNow:O}");
 }
}
