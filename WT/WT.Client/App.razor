@using WT.Client.Pages
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    @if (isLoading)
    {
        <LoadingScreen Text="Loading your experience..." />
    }
    else
    {
        <ErrorBoundary>
            <ErrorContent>
                <CustomError Error="context" />
            </ErrorContent>

            <ChildContent>
                <Router AppAssembly="@typeof(App).Assembly">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized>
                                <NotAuthorized />
                            </NotAuthorized>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                    </Found>
                    <NotFound>
                        @* ✅ Use your custom NotFound component *@
                        <LayoutView Layout="@typeof(MainLayout)">
                            <NotFound />
                        </LayoutView>
                    </NotFound>
                </Router>
            </ChildContent>
        </ErrorBoundary>

    }
</CascadingAuthenticationState>

@code {
    // No artificial startup delay in production - set to false so app renders immediately
    private bool isLoading = false;
}
