@using WT.Client.Pages
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    @if (isLoading)
    {
        <LoadingScreen Text="Loading your experience..." />
    }
    else
    {
        <ErrorBoundary>
            <ErrorContent>
                <CustomError Error="context" />
            </ErrorContent>

            <ChildContent>
                <Router AppAssembly="@typeof(App).Assembly">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized>
                                <NotAuthorized />
                            </NotAuthorized>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                    </Found>
                    <NotFound>
                        @* ✅ Use your custom NotFound component *@
                        <LayoutView Layout="@typeof(MainLayout)">
                            <NotFound />
                        </LayoutView>
                    </NotFound>
                </Router>
            </ChildContent>
        </ErrorBoundary>

    }
</CascadingAuthenticationState>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Simulate loading delay or perform startup logic
        await Task.Delay(4000); // Replace with actual loading logic
        isLoading = false;
    }
}
