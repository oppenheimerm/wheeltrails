@inject IJSRuntime JS

<div class="flex items-center gap-2">
    <!-- Dark Mode Toggle -->
    <button @onclick="ToggleDarkMode" 
            class="p-2 rounded-full hover:bg-md-surface-container transition-colors"
            title="Toggle dark mode">
        <span class="material-symbols-rounded text-md-on-surface">
            @(IsDarkMode ? "light_mode" : "dark_mode")
        </span>
    </button>
    <!-- ❌ REMOVED: Contrast Selector (not functional) -->
</div>

@code {
    private bool IsDarkMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsDarkMode = await JS.InvokeAsync<bool>(
            "eval", 
            "document.documentElement.classList.contains('dark')"
        );
    }

    private async Task ToggleDarkMode()
    {
        IsDarkMode = await JS.InvokeAsync<bool>("themeManager.toggleDarkMode");
    }
}