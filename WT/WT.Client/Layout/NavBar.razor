@using Blazored.LocalStorage
@using WT.Client.Components
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration

@code {
    private bool isMenuOpen = false;
    private bool isUserMenuOpen = false;
    private string? userProfilePicture;
    private string? userName;
    private string? userTitle;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
    }

    private void CloseUserMenu()
    {
        isUserMenuOpen = false;
    }

    private string MobileMenuClass => isMenuOpen ? "max-lg:block" : "max-lg:hidden";

    private string GetNavLinkClass(string href)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        var isActive = string.Equals(currentPath, href, StringComparison.OrdinalIgnoreCase);

        return isActive
            ? "text-[var(--md-sys-color-primary)] font-semibold border-b-2 border-[var(--md-sys-color-primary)]"
            : "text-[var(--md-sys-color-on-surface)] hover:text-[var(--md-sys-color-primary)] transition-colors";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        Console.WriteLine($"NavBar: User authenticated = {user.Identity?.IsAuthenticated}");
        Console.WriteLine($"NavBar: User name = {user.Identity?.Name}");

        // Set user information
        if (user.Identity?.IsAuthenticated == true)
        {
            userName = user.Identity.Name ?? "Guest User";
            userTitle = "Member"; // You can fetch this from claims or API
            // TODO: Load user profile picture from claims or API
            // For now, use temporary avatar
            userProfilePicture = "https://i.pravatar.cc/300";
        }
    }

    /// <summary>
    /// Handles user logout by clearing local storage and updating authentication state.
    /// </summary>
    private async Task HandleLogout()
    {
        try
        {
            // Clear local storage
            var localStorageKey = Configuration["ApplicationSettings:LocalStorageKey"];
            if (!string.IsNullOrEmpty(localStorageKey))
            {
                await LocalStorage.RemoveItemAsync(localStorageKey);
            }

            // Update authentication state to anonymous
            var customAuthStateProvider = (CustomAuthenticationStateProvider)AuthStateProvider;
            await customAuthStateProvider.UpdateAuthenticatedState(null);

            // Close the menus
            isUserMenuOpen = false;
            isMenuOpen = false;

            // ✅ Use forceLoad: true to ensure clean slate
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Logout error: {ex.Message}");
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }
}

<!-- ✨ Material Design 3 Top App Bar (Fixed Header) -->
<div class="bg-[var(--md-sys-color-surface-container)] fixed w-full z-20 top-0 start-0 border-b border-[var(--md-sys-color-outline-variant)] shadow-elevation-2">
    <header class="flex py-4 px-4 sm:px-10 min-h-[64px] tracking-wide relative z-50
               backdrop-blur-sm bg-[color:var(--md-sys-color-surface-container)/0.9]
               shadow-elevation-3 border-b border-[var(--md-sys-color-outline-variant)]">
        <div class="flex flex-wrap items-center justify-between gap-5 w-full">

            <!-- 🏠 Left Side - Logo & Brand -->
            <div class="flex items-center space-x-3 rtl:space-x-reverse">
                <a href="/" class="flex items-center space-x-3">
                    <img src="./img/assets/logo-light.png" alt="WheelyTrails logo" class="h-8 w-auto object-contain block dark:hidden" />
                    <img src="./img/assets/logo-dark.png" alt="WheelyTrails logo" class="h-8 w-auto object-contain hidden dark:block" />
                    <span class="max-sm:hidden text-2xl font-semibold tracking-tight text-[var(--md-sys-color-on-surface)]">
                        WheelyTrails
                    </span>
                </a>
            </div>

            <!-- 📱 Navigation Menu (Desktop & Mobile) -->
            <div id="collapseMenu"
                 class="lg:block max-lg:before:fixed max-lg:before:bg-black max-lg:before:opacity-50
                        max-lg:before:inset-0 max-lg:before:z-50 @MobileMenuClass">

                <!-- Close Button (Mobile Only) -->
                <button id="toggleClose" @onclick="ToggleMenu"
                        class="lg:hidden fixed top-4 right-4 z-[100] rounded-full bg-[var(--md-sys-color-surface-container-highest)]
                               w-10 h-10 flex items-center justify-center border border-[var(--md-sys-color-outline)]
                               hover:bg-[var(--md-sys-color-surface-container)] transition-colors shadow-elevation-1">
                    <span class="material-symbols-rounded text-[24px] text-[var(--md-sys-color-on-surface)]">
                        close
                    </span>
                </button>

                <!-- 📱 Mobile Side Navigation Drawer -->
                <div class="lg:flex gap-x-6
                            max-lg:fixed max-lg:top-0 max-lg:left-0 max-lg:bottom-16 max-lg:w-[280px]
                            max-lg:bg-[var(--md-sys-color-surface)] max-lg:shadow-elevation-3 max-lg:overflow-y-auto z-50
                            max-lg:flex max-lg:flex-col" id="mobile-menu-side">

                    <!-- 🎨 Mobile Menu Header with Profile (Mobile Only) -->
                    <div class="hidden max-lg:block bg-[var(--md-sys-color-primary-container)] pt-12 pb-8 px-6"
                         id="mobile-menu-side-header">
                        <AuthorizeView>
                            <Authorized>
                                <!-- User Profile Section -->
                                <div class="flex flex-col items-center text-center">
                                    <!-- Profile Image -->
                                    <div class="mb-4">
                                        <img src="@(userProfilePicture ?? "https://i.pravatar.cc/300")"
                                             alt="@userName profile picture"
                                             class="w-24 h-24 rounded-full border-4 border-[var(--md-sys-color-on-primary-container)]
                                                    object-cover shadow-elevation-2" />
                                    </div>

                                    <!-- User Name -->
                                    <h2 class="text-lg font-semibold text-[var(--md-sys-color-on-primary-container)] mb-1">
                                        @userName
                                    </h2>

                                    <!-- User Title/Role -->
                                    <p class="text-sm text-[var(--md-sys-color-on-primary-container)] opacity-80">
                                        @userTitle
                                    </p>
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <!-- Guest User Section -->
                                <div class="flex flex-col items-center text-center">
                                    <!-- Default Avatar -->
                                    <div class="mb-4">
                                        <div class="w-24 h-24 rounded-full bg-[var(--md-sys-color-on-primary-container)]
                                                    flex items-center justify-center border-4 border-[var(--md-sys-color-surface)]
                                                    shadow-elevation-2">
                                            <span class="material-symbols-rounded text-[48px] text-[var(--md-sys-color-primary-container)]">
                                                account_circle
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Guest Name -->
                                    <h2 class="text-lg font-semibold text-[var(--md-sys-color-on-primary-container)] mb-1">
                                        Guest User
                                    </h2>

                                    <!-- Sign In Prompt -->
                                    <a href="/account/identity/login"
                                       class="text-sm text-[var(--md-sys-color-on-primary-container)] underline hover:opacity-80">
                                        Sign in to your account
                                    </a>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>

                    <!-- 🔗 Navigation Links Container -->
                    <nav class="lg:flex lg:gap-x-6 max-lg:flex-1 max-lg:overflow-y-auto max-lg:bg-[var(--md-sys-color-surface)]">
                        <ul class="lg:flex lg:gap-x-6 max-lg:py-4">
                            <!-- Desktop: Horizontal Links | Mobile: Vertical Links -->
                            <li class="max-lg:border-b max-lg:border-[var(--md-sys-color-outline-variant)]">
                                <a href='/trails'
                                   class="@GetNavLinkClass("/trails/index") lg:block max-lg:flex max-lg:items-center max-lg:px-6 max-lg:py-4
                                          hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                   @onclick="() => isMenuOpen = false">
                                    <span class="hidden max-lg:inline-block material-symbols-rounded text-[24px] mr-4 text-[var(--md-sys-color-on-surface-variant)]">
                                        landscape
                                    </span>
                                    <span class="text-base lg:text-sm">Trails</span>
                                </a>
                            </li>
                            <li class="max-lg:border-b max-lg:border-[var(--md-sys-color-outline-variant)]">
                                <a href='/trails/discover'
                                   class="@GetNavLinkClass("/trails/discover") lg:block max-lg:flex max-lg:items-center max-lg:px-6 max-lg:py-4
                                          hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                   @onclick="() => isMenuOpen = false">
                                    <span class="hidden max-lg:inline-block material-symbols-rounded text-[24px] mr-4 text-[var(--md-sys-color-on-surface-variant)]">
                                        explore
                                    </span>
                                    <span class="text-base lg:text-sm">Discover</span>
                                </a>
                            </li>
                            <li class="max-lg:border-b max-lg:border-[var(--md-sys-color-outline-variant)]">
                                <a href='/shop'
                                   class="@GetNavLinkClass("/shop") lg:block max-lg:flex max-lg:items-center max-lg:px-6 max-lg:py-4
                                          hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                   @onclick="() => isMenuOpen = false">
                                    <span class="hidden max-lg:inline-block material-symbols-rounded text-[24px] mr-4 text-[var(--md-sys-color-on-surface-variant)]">
                                        shopping_bag
                                    </span>
                                    <span class="text-base lg:text-sm">Shop</span>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <!-- 📱 Mobile Menu Footer (Mobile Only) -->
                    <AuthorizeView>
                        <Authorized>
                            <div class="hidden max-lg:block border-t border-[var(--md-sys-color-outline-variant)] bg-[var(--md-sys-color-surface)]">
                                <!-- Settings Link -->
                                <a href="/account/identity/settings"
                                   class="flex items-center px-6 py-4 text-[var(--md-sys-color-on-surface)]
                                          hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors border-b border-[var(--md-sys-color-outline-variant)]"
                                   @onclick="() => isMenuOpen = false">
                                    <span class="material-symbols-rounded text-[24px] mr-4 text-[var(--md-sys-color-on-surface-variant)]">
                                        settings
                                    </span>
                                    <span class="text-base">Settings</span>
                                </a>

                                <!-- Logout Button -->
                                <button @onclick="HandleLogout"
                                        class="w-full flex items-center px-6 py-4 text-[var(--md-sys-color-error)]
                                               hover:bg-[var(--md-sys-color-error-container)] transition-colors">
                                    <span class="material-symbols-rounded text-[24px] mr-4">
                                        logout
                                    </span>
                                    <span class="text-base">Logout</span>
                                </button>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <!-- Mobile Menu Footer (NotAuthorized) -->
                            <div class="hidden max-lg:block border-t border-[var(--md-sys-color-outline-variant)]
                                        bg-[var(--md-sys-color-surface)] p-6 pb-6" id="mobile-menu-buttons-wrap">
                                <!-- Login & Register Buttons -->
                                <a href="/account/identity/login"
                                   class="block w-full mb-3 px-6 py-3 text-center bg-[var(--md-sys-color-primary)]
                                          text-[var(--md-sys-color-on-primary)] rounded-full font-medium
                                          hover:shadow-elevation-2 transition-shadow"
                                   @onclick="() => isMenuOpen = false">
                                    Login
                                </a>
                                <a href="/account/identity/register"
                                   class="block w-full px-6 py-3 text-center border border-[var(--md-sys-color-outline)]
                                          text-[var(--md-sys-color-primary)] rounded-full font-medium
                                          hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                   @onclick="() => isMenuOpen = false">
                                    Sign Up
                                </a>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>

            <!-- 👤 Right Side - Theme Toggle, Auth & Mobile Menu -->
            <div class="flex max-lg:ml-auto space-x-3 items-center">

                <!-- ✨ Theme Toggle Component -->
                <ThemeToggle />

                <!-- 🔐 Authentication Section (Desktop Only) -->
                <AuthorizeView>
                    <NotAuthorized>
                        <!-- Login & Sign Up Buttons (Not Logged In) -->
                        <a href="/account/identity/login"
                           class="hidden sm:inline-flex items-center px-6 py-2 bg-[var(--md-sys-color-primary)]
                                  text-[var(--md-sys-color-on-primary)] rounded-full font-medium
                                  hover:shadow-elevation-2 transition-shadow">
                            Login
                        </a>
                        <a href="/account/identity/register"
                           class="hidden sm:inline-flex items-center px-6 py-2 border border-[var(--md-sys-color-outline)]
                                  text-[var(--md-sys-color-primary)] rounded-full font-medium
                                  hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors">
                            Sign Up
                        </a>
                    </NotAuthorized>

                    <Authorized>
                        <!-- User Menu Dropdown (Logged In - Desktop Only) -->
                        <div class="relative hidden lg:block">
                            <!-- User Avatar Button -->
                            <button @onclick="ToggleUserMenu"
                                    class="flex items-center space-x-2 focus:outline-none focus:ring-2
                                           focus:ring-[var(--md-sys-color-primary)] focus:ring-offset-2 rounded-full"
                                    type="button"
                                    aria-label="User menu"
                                    aria-expanded="@isUserMenuOpen">
                                @if (!string.IsNullOrEmpty(userProfilePicture))
                                {
                                    <img src="@userProfilePicture"
                                         alt="@userName profile picture"
                                         class="w-10 h-10 rounded-full border-2 border-[var(--md-sys-color-primary)]
                                                    object-cover hover:border-[var(--md-sys-color-on-primary-container)]
                                                    transition-colors cursor-pointer" />
                                }
                                else
                                {
                                    <span class="material-symbols-rounded text-[40px] text-[var(--md-sys-color-primary)]
                                                     hover:text-[var(--md-sys-color-on-primary-container)] transition-colors cursor-pointer">
                                        account_circle
                                    </span>
                                }
                            </button>

                            <!-- Dropdown Menu -->
                            @if (isUserMenuOpen)
                            {
                                <div class="absolute right-0 mt-2 w-64 bg-[var(--md-sys-color-surface-container-high)]
                                               rounded-xl shadow-elevation-3 border border-[var(--md-sys-color-outline-variant)] z-50"
                                     @onclick:stopPropagation="true">

                                    <!-- Dropdown Header -->
                                    <div class="px-4 py-3 border-b border-[var(--md-sys-color-outline-variant)]">
                                        <p class="text-sm text-[var(--md-sys-color-on-surface-variant)]">Signed in as</p>
                                        <p class="text-base font-semibold text-[var(--md-sys-color-on-surface)] truncate">
                                            Hi, @userName
                                        </p>
                                    </div>

                                    <!-- Dropdown Links -->
                                    <div class="py-2">
                                        <a href="/account/profile"
                                           class="flex items-center px-4 py-3 text-sm text-[var(--md-sys-color-on-surface)]
                                                      hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                           @onclick="CloseUserMenu">
                                            <span class="material-symbols-rounded text-[20px] mr-3 text-[var(--md-sys-color-on-surface-variant)]">
                                                person
                                            </span>
                                            Profile
                                        </a>

                                        <a href="/account/settings"
                                           class="flex items-center px-4 py-3 text-sm text-[var(--md-sys-color-on-surface)]
                                                      hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                                           @onclick="CloseUserMenu">
                                            <span class="material-symbols-rounded text-[20px] mr-3 text-[var(--md-sys-color-on-surface-variant)]">
                                                settings
                                            </span>
                                            Settings
                                        </a>

                                        <hr class="my-2 border-[var(--md-sys-color-outline-variant)]" />

                                        <button @onclick="HandleLogout"
                                                class="w-full flex items-center px-4 py-3 text-sm text-[var(--md-sys-color-error)]
                                                           hover:bg-[var(--md-sys-color-error-container)] transition-colors text-left rounded-b-xl">
                                            <span class="material-symbols-rounded text-[20px] mr-3">
                                                logout
                                            </span>
                                            Logout
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- 📱 Mobile Menu Toggle Button -->
                <button @onclick="ToggleMenu"
                        id="toggleOpen"
                        class="lg:hidden p-2 rounded-full hover:bg-[var(--md-sys-color-surface-container-highest)] transition-colors"
                        aria-label="Toggle navigation menu">
                    <span class="material-symbols-rounded text-[28px] text-[var(--md-sys-color-on-surface]">
                        menu
                    </span>
                </button>
            </div>
        </div>
    </header>
</div>