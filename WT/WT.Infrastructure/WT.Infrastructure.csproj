<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WT.Infrastructure</RootNamespace>
    <UserSecretsId>434ce5bd-2ce4-4e7b-add9-cbfeb70b1c45</UserSecretsId>
  </PropertyGroup>

  <!-- ✅ STEP 1: Remove the file from default compilation -->
  <ItemGroup>
    <None Remove="Data\BadWords.en.txt" />
  </ItemGroup>

  <!-- ✅ STEP 2: Add as embedded resource with explicit logical name -->
  <ItemGroup>
    <EmbeddedResource Include="Data\BadWords.en.txt">
      <LogicalName>WT.Infrastructure.Data.BadWords.en.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="FirebaseAdmin" Version="3.4.0" />
    <PackageReference Include="FirebaseAuthentication.net" Version="4.1.0" />
    <PackageReference Include="FirebaseStorage.net" Version="1.0.3" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.13.0" />
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />	
	  
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>	
	  
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />	
	  
    <PackageReference Include="Scalar.AspNetCore" Version="2.11.0" />	
	  
    <PackageReference Include="SendGrid" Version="9.29.3" />	
	  
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />	
	  
    <PackageReference Include="SixLabors.ImageSharp.Web" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WT.Application\WT.Application.csproj" />
    <ProjectReference Include="..\WT.Domain\WT.Domain.csproj" />
  </ItemGroup>

</Project>
